<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results — Sumati Color Lab</title>
    <link rel="stylesheet" href="/css/camera.css">
    <link rel="stylesheet" href="/css/user-nav.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="/js/cart-sync-head.js"></script>
    <style>
        body {
            background-color: #0f0f0f;
            color: #fff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .search-results-page {
            padding-top: 5rem;
            flex: 1;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            padding-left: 2rem;
            padding-right: 2rem;
            box-sizing: border-box;
        }

        .search-header-box {
            padding: 1.5rem 0 2rem 0;
            border-bottom: 1px solid #222;
            margin-bottom: 2rem;
        }

        .search-header-box h1 {
            font-size: 2.2rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 0.5rem;
        }

        .search-header-box span.highlight {
            color: orange;
        }

        .search-header-box p {
            color: #888;
            font-size: 1rem;
        }

        /* Empty State */
        .empty-search-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 5rem 2rem;
            background: #141414;
            border: 1px dashed #333;
            border-radius: 20px;
            margin: 2rem 0 4rem 0;
        }

        .empty-search-icon {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: rgba(255, 165, 0, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: orange;
            margin-bottom: 1.5rem;
        }

        .empty-search-container h2 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
            color: #fff;
        }

        .empty-search-container p {
            color: #999;
            max-width: 500px;
            line-height: 1.6;
            margin-bottom: 2rem;
            font-size: 1rem;
        }

        .empty-search-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .empty-btn-primary {
            background: orange;
            color: #000;
            padding: 0.85rem 2rem;
            border-radius: 30px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .empty-btn-primary:hover {
            background: #ff8c00;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 165, 0, 0.3);
        }

        .empty-btn-secondary {
            background: #222;
            color: #fff;
            padding: 0.85rem 2rem;
            border-radius: 30px;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid #444;
            transition: all 0.3s ease;
        }

        .empty-btn-secondary:hover {
            background: #333;
            color: orange;
            border-color: orange;
        }
    </style>
</head>

<body>
    <header>
        <nav>
            <div class="navigation">
                <a href="/" class="nav-logo-link" title="Home">
                    <img src="/assets/images/logo.jpeg" alt="Sumati Colour Lab Logo" class="nav-logo-img">
                </a>
                <a href="/products">Camera</a>
                <a href="/lenses">Lens</a>
                <a href="/accessories">Accessories</a>
                <a href="#" class="cart-anchor" title="Cart">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="cart-count">0</span>
                </a>
                <div class="options">
                    <input type="text" placeholder="Search" value="<%= query %>">
                    <label>
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </label>
                    <% if (user) { %>
                        <button type="button" class="login" onclick="window.location='/auth/logout'"><%= user.name %></button>
                    <% } else { %>
                        <button type="button" class="login" onclick="window.location='/auth/login'">Log In</button>
                    <% } %>
                </div>
            </div>
        </nav>
    </header>

    <main class="search-results-page">
        <div class="search-header-box">
            <h1>Search Results for <span class="highlight">"<%= query %>"</span></h1>
            <p><%= products ? products.length : 0 %> matching items found</p>
        </div>

        <% if (products && products.length > 0) { %>
            <div class="main-camera-screen" style="display: block; width: 100%;">
                <div class="main-camera-cards" style="width: 100%; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
                    <% products.forEach(p => { %>
                        <a href="/product/<%= p.slug || p._id %>" class="product-card-link">
                            <div class="camera-cards" data-price="<%= p.price %>">
                                <div class="img-container">
                                    <img src="<%= p.image %>" alt="<%= p.title %>">
                                </div>
                                <div class="content">
                                    <h2><%= p.title %></h2>
                                    <% if (p.highlights && p.highlights.length > 0) { %>
                                        <ul>
                                            <% p.highlights.slice(0, 3).forEach(h => { %>
                                                <li><%= h %></li>
                                            <% }); %>
                                        </ul>
                                    <% } else if (p.description) { %>
                                        <p><%= p.description.substring(0, 100) %>...</p>
                                    <% } %>
                                </div>
                                <div class="card-footer">
                                    <h2 class="price">₹<%= p.price ? p.price.toLocaleString('en-IN') : 'N/A' %>/-</h2>
                                    <button type="button">Explore</button>
                                </div>
                            </div>
                        </a>
                    <% }); %>
                </div>
            </div>
        <% } else { %>
            <div class="empty-search-container">
                <div class="empty-search-icon">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>
                <h2>No Matching Products Found</h2>
                <p>We couldn't find anything matching "<strong style="color: #fff;"><%= query %></strong>". Check for spelling errors or try searching for generic terms like <em>Sony</em>, <em>Canon</em>, <em>Lens</em>, or <em>Tripod</em>.</p>
                <div class="empty-search-actions">
                    <a href="/products" class="empty-btn-primary">Browse All Products</a>
                    <a href="/" class="empty-btn-secondary">Return to Home</a>
                </div>
            </div>
        <% } %>
    </main>

    <footer>
        <div class="footer-main">
            <div class="footer-bottom">
                <hr>
                <p>Copyright © 2026 Sumati Color Lab. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

    <script src="/js/search-results.js"></script>
    <script src="/js/popup.js"></script>
    <script src="/js/user-nav.js"></script>
    <script src="/js/cart.js" defer></script>
</body>

</html>
