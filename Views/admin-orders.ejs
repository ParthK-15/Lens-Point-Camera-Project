<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders | Admin — Sumati Colour Lab</title>
    <link rel="stylesheet" href="/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="admin-page">

    <!-- ── Sidebar ──────────────────────────────────────────── -->
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">
                <i class="fa-solid fa-camera"></i>
            </div>
            <div class="sidebar-brand-text">
                <h2>Sumati Lab</h2>
                <span>Admin Panel</span>
            </div>
        </div>
        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Main</div>
            <a href="/admin/dashboard" class="sidebar-link">
                <i class="fa-solid fa-chart-pie"></i> Dashboard
            </a>
            <a href="/admin/products" class="sidebar-link">
                <i class="fa-solid fa-box"></i> Products
            </a>
            <a href="/admin/orders" class="sidebar-link active">
                <i class="fa-solid fa-receipt"></i> Orders
            </a>
            <div class="sidebar-section-label">Store</div>
            <a href="/" class="sidebar-link" target="_blank">
                <i class="fa-solid fa-store"></i> View Store
            </a>
        </nav>
        <div class="sidebar-footer">
            <a href="/admin/logout" class="sidebar-link">
                <i class="fa-solid fa-right-from-bracket"></i> Log Out
            </a>
        </div>
    </aside>

    <!-- ── Main Content ─────────────────────────────────────── -->
    <main class="admin-main">
        <div class="admin-topbar">
            <div style="display:flex;align-items:center;gap:0.75rem;">
                <button class="sidebar-toggle" onclick="document.getElementById('adminSidebar').classList.toggle('open')">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="topbar-title">
                    <h1>Orders</h1>
                    <p>Track and manage customer orders</p>
                </div>
            </div>
        </div>

        <div class="admin-content">
            <div class="admin-table-wrap">
                <div class="admin-table-header">
                    <h2>All Orders (<%= orders.length %>)</h2>
                    <div class="admin-table-actions">
                        <form method="GET" action="/admin/orders" style="display:flex;gap:0.75rem;align-items:center;">
                            <select name="status" class="admin-select" onchange="this.form.submit()">
                                <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>All Status</option>
                                <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending</option>
                                <option value="confirmed" <%= statusFilter === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                                <option value="shipped" <%= statusFilter === 'shipped' ? 'selected' : '' %>>Shipped</option>
                                <option value="delivered" <%= statusFilter === 'delivered' ? 'selected' : '' %>>Delivered</option>
                                <option value="cancelled" <%= statusFilter === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                            </select>
                        </form>
                    </div>
                </div>

                <% if (orders.length === 0) { %>
                    <div class="empty-state">
                        <i class="fa-solid fa-receipt"></i>
                        <h3>No orders found</h3>
                        <p>Orders will appear here once customers start placing them.</p>
                    </div>
                <% } else { %>
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th>Location</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% orders.forEach(function(order) { %>
                                <tr>
                                    <td style="font-family:monospace;font-size:0.78rem;color:var(--admin-text-dim);">
                                        #<%= order._id.toString().slice(-6).toUpperCase() %>
                                    </td>
                                    <td>
                                        <div>
                                            <div style="font-weight:500;"><%= order.customerName %></div>
                                            <div style="font-size:0.75rem;color:var(--admin-text-dim);"><%= order.customerEmail || '—' %></div>
                                        </div>
                                    </td>
                                    <td style="font-size:0.85rem;"><%= order.customerPhone || '—' %></td>
                                    <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.85rem;">
                                        <%= order.shippingAddress || '—' %>
                                    </td>
                                    <td style="text-align:center;"><%= order.items.length %></td>
                                    <td style="font-weight:600;">₹<%= order.totalAmount.toLocaleString('en-IN') %></td>
                                    <td>
                                        <span class="status-badge <%= order.status %>"><%= order.status %></span>
                                    </td>
                                    <td style="color:var(--admin-text-dim);font-size:0.82rem;white-space:nowrap;">
                                        <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %>
                                    </td>
                                    <td>
                                        <a href="/admin/orders/<%= order._id %>" class="btn btn-secondary btn-sm">View</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>
    </main>

</body>

</html>
