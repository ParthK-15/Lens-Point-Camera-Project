<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cameras</title>
    <link rel="stylesheet" href="/camera.css">
    <link rel="stylesheet" href="/user-nav.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="/cart-sync-head.js"></script>
</head>

<body>
    <header>
        <nav>
            <div class="navigation">
                <a href="/index.html" class="nav-logo-link" title="Home"><img src="/Assets/logo.jpeg" alt="Sumati Colour Lab Logo" class="nav-logo-img"></a>
                <a href="/products" class="active">Camera</a>
                <a href="/lenses">Lens</a>
                <a href="/accessories.html">Accessories</a>
                <a href="#" class="cart-anchor" title="Cart">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="cart-count">0</span>
                </a>
                <div class="options">
                    <input type="text" placeholder="Search">
                    <label for="input">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </label>
                    <button type="button" class="login">Log In</button>
                </div>
            </div>
        </nav>
    </header>
    <div class="main-camera-screen">
        <div class="sidebar">
            <div class="filter-header">
                <h2>Filters</h2>
                <button id="reset-btn" title="Reset all filters">Reset</button>
            </div>
            <div class="price-container">
                <h3>Price</h3>
                <div class="price-item">
                    <input type="checkbox" id="price-check1" class="price-checkbox" value="all" checked>
                    <label for="price-check1">All</label>
                </div>
                <div class="price-item">
                    <input type="checkbox" id="price-check2" class="price-checkbox" value="Under 20000">
                    <label for="price-check2">Under ₹20,000</label>
                </div>
                <div class="price-item">
                    <input type="checkbox" id="price-check3" class="price-checkbox" value="20000-50000">
                    <label for="price-check3">₹20,000 - ₹50,000</label>
                </div>
                <div class="price-item">
                    <input type="checkbox" id="price-check4" class="price-checkbox" value="50000-70000">
                    <label for="price-check4">₹50,000 - ₹70,000</label>
                </div>
                <div class="price-item">
                    <input type="checkbox" id="price-check5" class="price-checkbox" value="70000-100000">
                    <label for="price-check5">₹70,000 - ₹1,00,000</label>
                </div>
                <div class="price-item">
                    <input type="checkbox" id="price-check6" class="price-checkbox" value="Over 100000">
                    <label for="price-check6">Over ₹1,00,000</label>
                </div>
            </div>
            <div class="company-container">
                <h3>Brands</h3>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check1" class="brands-checkbox" value="all" checked>
                    <label for="brands-check1">All</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check2" class="brands-checkbox" value="sony">
                    <label for="brands-check2">Sony</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check3" class="brands-checkbox" value="nikon">
                    <label for="brands-check3">Nikon</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check4" class="brands-checkbox" value="canon">
                    <label for="brands-check4">Canon</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check5" class="brands-checkbox" value="fujifilm">
                    <label for="brands-check5">Fujifilm</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check6" class="brands-checkbox" value="gopro">
                    <label for="brands-check6">GoPro</label>
                </div>
            </div>
            <div class="category-container">
                <h3>Categories</h3>
                <div class="brands-name">
                    <input type="checkbox" id="category-check1" class="category-checkbox" value="all" checked>
                    <label for="category-check1">All</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="category-check2" class="category-checkbox" value="dslr">
                    <label for="category-check2">DSLR</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="category-check3" class="category-checkbox" value="mirrorless">
                    <label for="category-check3">Mirrorless</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="category-check4" class="category-checkbox" value="compact">
                    <label for="category-check4">Compact Cameras</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="category-check5" class="category-checkbox" value="action">
                    <label for="category-check5">Action Cameras</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="category-check6" class="category-checkbox" value="360">
                    <label for="category-check6">360-Degree Cameras</label>
                </div>
            </div>
            <a href="/lenses" class="sidebar-links">Lenses</a>
            <a href="/accessories.html" class="sidebar-links">Accessories</a>
            <a href="/tripod.html" class="sidebar-links">Tripods</a>
            <a href="/lightings.html" class="sidebar-links">Lights</a>
        </div>
        <div class="main-camera-cards">
            <% products.forEach(product=>{ %>
            <a href="/products/<%= product.slug %>">
                <div class="camera-cards <%= product.subCategory %>" id="camera-<%= product.slug %>"
                    data-price="<%= product.price %>"
                    data-brand="<%= product.company.toLowerCase() %>"
                    data-category="<%= product.subCategory %>">
                    <div class="img-container">
                        <img src="<%= product.image %>" alt="<%= product.title %>">
                    </div>
                    <div class="content">
                        <h2><%= product.title %></h2>
                        <ul>
                            <% product.features.slice(0, 3).forEach(function(feature) { %>
                                <li><%= feature %></li>
                            <% }) %>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <h2 class="price">₹<%= product.price.toLocaleString('en-IN') %>/-</h2>
                        <button>Explore</button>
                    </div>
                </div>
            </a>
            <% }) %>
        </div>
    </div>
        <footer>
            <div class="footer-main">
                <div class="main-footer">
                    <div class="brands">
                        <h2>Brands</h2>
                        <input type="checkbox" class="footer-checkbox" id="brands-check">
                        <label for="brands-check">
                            <i class="fa-solid fa-angle-down"></i>
                        </label>
                        <ul>
                            <li>Sony</li>
                            <li>Canon</li>
                            <li>Nikon</li>
                            <li>Fujifilm</li>
                            <li>GoPro</li>
                        </ul>
                    </div>
                    <div class="categories">
                        <h2>Categories</h2>
                        <input type="checkbox" class="footer-checkbox" id="categories-check">
                        <label for="categories-check">
                            <i class="fa-solid fa-angle-down"></i>
                        </label>
                        <ul>
                            <li>DSLR Cameras</li>
                            <li>Mirrorless Cameras</li>
                            <li>Lenses</li>
                            <li>Tripods</li>
                            <li>Lighting Equipment</li>
                        </ul>
                    </div>
                    <div class="foot-contact">
                        <h2>Contact Us</h2>
                        <input type="checkbox" class="footer-checkbox" id="contact-check">
                        <label for="contact-check">
                            <i class="fa-solid fa-angle-down"></i>
                        </label>
                        <p><i class="fa-solid fa-phone"></i> +91 7038418286</p>
                        <a href="https://www.instagram.com/sumati.color.lab?igsh=ZHIzam5hc3N6bmdj"><i
                                class="fa-brands fa-instagram"></i> Instagram</a>
                        <a href="mailto:khushallll409@gmail.com"><i class="fa-regular fa-envelope"></i> Gmail</a>
                    </div>
                    <div class="foot-location">
                        <h2>Our Location</h2>
                        <input type="checkbox" class="footer-checkbox" id="location-check">
                        <label for="location-check">
                            <i class="fa-solid fa-angle-down"></i>
                        </label>
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3766.527047318591!2d76.77415409999999!3d19.259433299999994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bd019cc2af79f0d%3A0x4d9b3ade4eff331!2sSumati%20Colour%20Lab!5e0!3m2!1sen!2sin!4v1772262216473!5m2!1sen!2sin"
                            style="border:0;" allowfullscreen="" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
                <div class="footer-bottom">
                    <hr>
                    <p>Copyright © 2026 Sumati Color Lab. All Rights Reserved.</p>
                </div>
            </div>
        </footer>

        <script src="/camera.js"></script>
        <script src="/popup.js"></script>
        <script src="/user-nav.js"></script>
        <script src="/cart.js" defer></script>
</body>

</html>