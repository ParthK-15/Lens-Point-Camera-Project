<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= config ? config.title : 'Products' %> — Sumati Color Lab</title>
    <link rel="stylesheet" href="<%= config && config.css ? config.css : '/css/camera.css' %>">
    <link rel="stylesheet" href="/css/user-nav.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="/js/cart-sync-head.js"></script>
</head>

<body>
    <header>
        <nav>
            <div class="navigation">
                <a href="/" class="nav-logo-link" title="Home"><img src="/assets/images/logo.jpeg" alt="Sumati Colour Lab Logo" class="nav-logo-img"></a>
                <a href="/products" class="<%= (typeof activeNav !== 'undefined' && activeNav === 'camera') ? 'active' : '' %>">Camera</a>
                <a href="/lenses" class="<%= (typeof activeNav !== 'undefined' && activeNav === 'lens') ? 'active' : '' %>">Lens</a>
                <a href="/accessories" class="<%= (typeof activeNav === 'undefined' || activeNav === 'accessories' || (typeof config !== 'undefined' && (config.parentNav === 'accessories' || config.category === 'accessories' || true))) ? 'active' : '' %>">Accessories</a>
                <a href="#" class="cart-anchor" title="Cart">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="cart-count">0</span>
                </a>
                <div class="options">
                    <input type="text" placeholder="Search">
                    <label>
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </label>
                    <% if (user) { %>
                        <button type="button" class="login" onclick="window.location='/auth/logout'"><%= user.name %></button>
                    <% } else { %>
                        <button type="button" class="login" onclick="window.location='/auth/login'">Log In</button>
                    <% } %>
                </div>
            </div>
        </nav>
    </header>

    <aside>
        <input type="checkbox" id="check">
        <div class="btn_one">
            <label for="check">
                <i class="fa-solid fa-bars"></i>
            </label>
        </div>
        <div class="mainbox">
            <div class="btn_two">
                <label for="check">
                    <i class="fa-solid fa-xmark"></i>
                </label>
            </div>
            <div class="sidebar">
                <div class="head">
                    <a href="/"><img src="/assets/images/logo.jpeg" alt="Sumati Colour Lab Logo" class="mobile-menu-logo"></a>
                </div>
                <hr>
                <div class="sidebar_menu">
                    <a href="/">Home</a>
                    <a href="/products">Camera</a>
                    <a href="/lenses">Lens</a>
                    <a href="/accessories">Accessories</a>
                    <a href="#" class="cart-anchor-mobile">
                        <i class="fa-solid fa-cart-shopping"></i> Cart
                        <span class="cart-count-mobile">0</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="searchIcon">
            <input type="text" placeholder="Search" class="inputMobile">
            <label>
                <i class="fa-solid fa-magnifying-glass" id="searchButton"></i>
            </label>
            <% if (user) { %>
                <button class="login2" onclick="window.location='/auth/logout'"><%= user.name %></button>
            <% } else { %>
                <button class="login2" onclick="window.location='/auth/login'">Log In</button>
            <% } %>
        </div>
    </aside>

    <div class="main-camera-screen">
        <div class="sidebar">
            <div class="filter-header">
                <h2>Filters</h2>
                <button id="reset-btn" title="Reset all filters">Reset</button>
            </div>
            <% if (config && config.priceRanges && config.priceRanges.length > 0) { %>
            <div class="price-container">
                <h3>Price</h3>
                <div class="price-item">
                    <input type="checkbox" id="price-check-all" class="price-checkbox" value="all" checked>
                    <label for="price-check-all">All</label>
                </div>
                <% config.priceRanges.forEach((range, idx) => { %>
                <div class="price-item">
                    <input type="checkbox" id="price-check-<%= idx %>" class="price-checkbox" value="<%= range.value %>">
                    <label for="price-check-<%= idx %>"><%= range.label %></label>
                </div>
                <% }); %>
            </div>
            <% } %>

            <% if (brands && brands.length > 0) { %>
            <div class="company-container">
                <h3>Brands</h3>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check-all" class="brands-checkbox" value="all" checked>
                    <label for="brands-check-all">All</label>
                </div>
                <% brands.forEach((brand, idx) => { %>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check-<%= idx %>" class="brands-checkbox" value="<%= brand.toLowerCase() %>">
                    <label for="brands-check-<%= idx %>"><%= brand %></label>
                </div>
                <% }); %>
            </div>
            <% } %>

            <% if (subCategories && subCategories.length > 0) { %>
            <div class="category-container">
                <h3>Subcategories</h3>
                <div class="brands-name">
                    <input type="checkbox" id="cat-check-all" class="category-checkbox" value="all" checked>
                    <label for="cat-check-all">All</label>
                </div>
                <% subCategories.forEach((sub, idx) => { %>
                <div class="brands-name">
                    <input type="checkbox" id="cat-check-<%= idx %>" class="category-checkbox" value="<%= sub.toLowerCase() %>">
                    <label for="cat-check-<%= idx %>"><%= sub %></label>
                </div>
                <% }); %>
            </div>
            <% } %>

            <a href="/products" class="sidebar-links">Cameras</a>
            <a href="/lenses" class="sidebar-links">Lenses</a>
            <a href="/accessories" class="sidebar-links">Accessories</a>
        </div>

        <div class="main-camera-cards">
            <% if (products && products.length > 0) { %>
                <% products.forEach(p => { %>
                    <a href="/product/<%= p.slug || p._id %>" class="product-card-link">
                        <div class="camera-cards" 
                             data-price="<%= p.price %>" 
                             data-brand="<%= (p.company || '').toLowerCase() %>" 
                             data-category="<%= (p.subCategory || '').toLowerCase() %>">
                            <div class="card-img-container">
                                <img src="<%= p.image %>" alt="<%= p.title %>">
                            </div>
                            <div class="card-text-content">
                                <h2 class="card-title"><%= p.title %></h2>
                                <ul class="card-highlights">
                                    <% if (p.highlights && p.highlights.length > 0) { %>
                                        <% p.highlights.slice(0, 4).forEach(h => { %>
                                            <li><%= h %></li>
                                        <% }); %>
                                    <% } else if (p.features && p.features.length > 0) { %>
                                        <% p.features.slice(0, 4).forEach(h => { %>
                                            <li><%= h %></li>
                                        <% }); %>
                                    <% } else if (p.description) { %>
                                        <li><%= p.description.substring(0, 80) %>...</li>
                                    <% } %>
                                </ul>
                                <div class="card-footer">
                                    <span class="card-price">₹<%= p.price ? p.price.toLocaleString('en-IN') : 'N/A' %>/-</span>
                                    <button class="card-explore-btn">Explore</button>
                                </div>
                            </div>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <div style="padding: 3rem; text-align: center; width: 100%;">
                    <h2>No products found in <%= config ? config.title : category %>.</h2>
                </div>
            <% } %>
        </div>
    </div>

    <footer>
        <div class="footer-main">
            <div class="main-footer">
                <div class="brands">
                    <h2>Brands</h2>
                    <input type="checkbox" class="footer-checkbox" id="brands-check">
                    <label for="brands-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <ul>
                        <li>Sony</li>
                        <li>Canon</li>
                        <li>Nikon</li>
                        <li>Fujifilm</li>
                        <li>GoPro</li>
                    </ul>
                </div>
                <div class="categories">
                    <h2>Categories</h2>
                    <input type="checkbox" class="footer-checkbox" id="categories-check">
                    <label for="categories-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <ul>
                        <li>DSLR Cameras</li>
                        <li>Mirrorless Cameras</li>
                        <li>Lenses</li>
                        <li>Tripods</li>
                        <li>Lighting Equipment</li>
                    </ul>
                </div>
                <div class="foot-contact">
                    <h2>Contact Us</h2>
                    <input type="checkbox" class="footer-checkbox" id="contact-check">
                    <label for="contact-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <p><i class="fa-solid fa-phone"></i> +91 7038418286</p>
                    <a href="https://www.instagram.com/sumati.color.lab?igsh=ZHIzam5hc3N6bmdj"><i class="fa-brands fa-instagram"></i> Instagram</a>
                    <a href="mailto:khushallll409@gmail.com"><i class="fa-regular fa-envelope"></i> Gmail</a>
                </div>
                <div class="foot-location">
                    <h2>Our Location</h2>
                    <input type="checkbox" class="footer-checkbox" id="location-check">
                    <label for="location-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3766.527047318591!2d76.77415409999999!3d19.259433299999994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bd019cc2af79f0d%3A0x4d9b3ade4eff331!2sSumati%20Colour%20Lab!5e0!3m2!1sen!2sin!4v1772262216473!5m2!1sen!2sin"
                        style="border:0;" allowfullscreen="" loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
            <div class="footer-bottom">
                <hr>
                <p>Copyright © 2026 Sumati Color Lab. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        (function() {
            function routeSearch(input) {
                if (!input) return;
                var q = input.value.trim();
                if (!q) return;
                window.location.href = '/search?q=' + encodeURIComponent(q);
            }
            document.addEventListener('DOMContentLoaded', function() {
                var di = document.querySelector('.options input[type="text"]');
                var dIcon = document.querySelector('.options i.fa-magnifying-glass');
                var mi = document.querySelector('.inputMobile');
                var mIcon = document.getElementById('searchButton');
                if (di) di.addEventListener('keydown', function(e) { if (e.key === 'Enter') routeSearch(di); });
                if (dIcon) dIcon.addEventListener('click', function() { routeSearch(di); });
                if (mi) mi.addEventListener('keydown', function(e) { if (e.key === 'Enter') routeSearch(mi); });
                if (mIcon) mIcon.addEventListener('click', function() { routeSearch(mIcon); });
            });
        })();
    </script>
    <% if (config && config.js) { %>
        <script src="<%= config.js %>"></script>
    <% } %>
    <script src="/js/popup.js"></script>
    <script src="/js/user-nav.js"></script>
    <script src="/js/cart.js" defer></script>
</body>

</html>
