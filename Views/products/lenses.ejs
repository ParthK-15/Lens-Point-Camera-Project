<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lenses — Sumati Color Lab</title>
    <link rel="stylesheet" href="/css/lens.css">
    <link rel="stylesheet" href="/css/user-nav.css">
    <link rel="stylesheet" href="/css/search-autocomplete.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="/js/cart-sync-head.js"></script>
</head>

<body>
    <header>
        <nav>
            <div class="navigation">
                <a href="/" class="nav-logo-link" title="Home"><img src="/assets/images/logo.jpeg" alt="Sumati Colour Lab Logo" class="nav-logo-img"></a>
                <a href="/products">Camera</a>
                <a href="/lenses" class="active">Lens</a>
                <a href="/accessories">Accessories</a>
                <a href="#" class="cart-anchor" title="Cart">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="cart-count">0</span>
                </a>
                <div class="options">
                    <input type="text" placeholder="Search">
                    <label>
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </label>
                    <% if (user) { %>
                        <% 
                            let initials = '?';
                            if (user.name) {
                                const parts = user.name.trim().split(/\s+/);
                                if (parts.length >= 2) { initials = (parts[0][0] + parts[1][0]).toUpperCase(); }
                                else { initials = parts[0].substring(0, 2).toUpperCase(); }
                            }
                        %>
                        <button type="button" class="user-avatar-btn" title="Signed in as <%= user.name %>" aria-label="Open profile menu"><%= initials %></button>
                    <% } else { %>
                        <button type="button" class="login" onclick="window.location='/auth/login'">Log In</button>
                    <% } %>
                </div>
            </div>
        </nav>
    </header>

    <aside>
        <input type="checkbox" id="check">
        <div class="btn_one">
            <label for="check">
                <i class="fa-solid fa-bars"></i>
            </label>
        </div>
        <div class="mainbox">
            <div class="btn_two">
                <label for="check">
                    <i class="fa-solid fa-xmark"></i>
                </label>
            </div>
            <div class="sidebar">
                <div class="head">
                    <a href="/"><img src="/assets/images/logo.jpeg" alt="Sumati Colour Lab Logo" class="mobile-menu-logo"></a>
                </div>
                <hr>
                <div class="sidebar_menu">
                    <a href="/">Home</a>
                    <a href="/products">Camera</a>
                    <a href="/lenses">Lens</a>
                    <a href="/accessories">Accessories</a>
                    <a href="#" class="cart-anchor-mobile">
                        <i class="fa-solid fa-cart-shopping"></i> Cart
                        <span class="cart-count-mobile">0</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="searchIcon">
            <input type="text" placeholder="Search" class="inputMobile">
            <label for="input">
                <i class="fa-solid fa-magnifying-glass" id="searchButton"></i>
            </label>
            <% if (user) { %>
                <% 
                    let initials = '?';
                    if (user.name) {
                        const parts = user.name.trim().split(/\s+/);
                        if (parts.length >= 2) { initials = (parts[0][0] + parts[1][0]).toUpperCase(); }
                        else { initials = parts[0].substring(0, 2).toUpperCase(); }
                    }
                %>
                <button type="button" class="user-avatar-btn" title="Signed in as <%= user.name %>" aria-label="Open profile menu"><%= initials %></button>
            <% } else { %>
                <button class="login2" onclick="window.location='/auth/login'">Log In</button>
            <% } %>
        </div>
    </aside>

    <div class="main-camera-screen">
        <div class="sidebar">
            <div class="filter-header">
                <h2>Filters</h2>
                <button id="reset-btn" title="Reset all filters">Reset</button>
            </div>
            <div class="price-container">
                <h3>Price</h3>
                <div class="price-item">
                    <input type="checkbox" id="price-check1" class="price-checkbox" value="all" checked>
                    <label for="price-check1">All</label>
                </div>
                <div class="price-item">
                    <input type="checkbox" id="price-check2" class="price-checkbox" value="Under 10000">
                    <label for="price-check2">Under ₹10,000</label>
                </div>
                <div class="price-item">
                    <input type="checkbox" id="price-check3" class="price-checkbox" value="10000-30000">
                    <label for="price-check3">₹10,000 - ₹30,000</label>
                </div>
                <div class="price-item">
                    <input type="checkbox" id="price-check4" class="price-checkbox" value="30000-50000">
                    <label for="price-check4">₹30,000 - ₹50,000</label>
                </div>
                <div class="price-item">
                    <input type="checkbox" id="price-check5" class="price-checkbox" value="50000-90000">
                    <label for="price-check5">₹50,000 - ₹90,000</label>
                </div>
                <div class="price-item">
                    <input type="checkbox" id="price-check6" class="price-checkbox" value="Over 90000">
                    <label for="price-check6">Over ₹90,000</label>
                </div>
            </div>
            <div class="company-container">
                <h3>Brands</h3>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check1" class="brands-checkbox" value="all" checked>
                    <label for="brands-check1">All</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check2" class="brands-checkbox" value="sony">
                    <label for="brands-check2">Sony</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check3" class="brands-checkbox" value="nikon">
                    <label for="brands-check3">Nikon</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check4" class="brands-checkbox" value="canon">
                    <label for="brands-check4">Canon</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check5" class="brands-checkbox" value="sigma">
                    <label for="brands-check5">Sigma</label>
                </div>
                <div class="brands-name">
                    <input type="checkbox" id="brands-check6" class="brands-checkbox" value="tamron">
                    <label for="brands-check6">Tamron</label>
                </div>
            </div>
            <a href="/products" class="sidebar-links">Cameras</a>
            <a href="/accessories" class="sidebar-links">Accessories</a>
            <a href="/tripods" class="sidebar-links">Tripods</a>
        </div>

        <div class="main-camera-cards">
            <% if (products && products.length > 0) { %>
                <% products.forEach(p => { %>
                    <a href="/product/<%= p.slug || p._id %>" class="product-card-link">
                        <div class="camera-cards <%= (p.subCategory || '').toLowerCase() %>" 
                             data-price="<%= p.price %>" 
                             data-brand="<%= (p.company || '').toLowerCase() %>" 
                             data-category="<%= (p.subCategory || '').toLowerCase() %>">
                            <div class="card-img-container">
                                <img src="<%= p.image %>" alt="<%= p.title %>">
                            </div>
                            <div class="card-text-content">
                                <h2 class="card-title"><%= p.title %></h2>
                                <ul class="card-highlights">
                                    <% if (p.highlights && p.highlights.length > 0) { %>
                                        <% p.highlights.slice(0, 4).forEach(h => { %>
                                            <li><%= h %></li>
                                        <% }); %>
                                    <% } else if (p.features && p.features.length > 0) { %>
                                        <% p.features.slice(0, 4).forEach(h => { %>
                                            <li><%= h %></li>
                                        <% }); %>
                                    <% } else if (p.description) { %>
                                        <li><%= p.description.substring(0, 80) %>...</li>
                                    <% } %>
                                </ul>
                                <div class="card-footer">
                                    <span class="card-price">₹<%= p.price ? p.price.toLocaleString('en-IN') : 'N/A' %>/-</span>
                                    <button class="card-explore-btn">Explore</button>
                                </div>
                            </div>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <div style="padding: 3rem; text-align: center; width: 100%;">
                    <h2>No lenses found.</h2>
                </div>
            <% } %>
        </div>
    </div>

    <footer>
        <div class="footer-main">
            <div class="main-footer">
                <div class="brands">
                    <h2>Brands</h2>
                    <input type="checkbox" class="footer-checkbox" id="brands-check">
                    <label for="brands-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <ul>
                        <li>Sony</li>
                        <li>Canon</li>
                        <li>Nikon</li>
                        <li>Fujifilm</li>
                        <li>GoPro</li>
                    </ul>
                </div>
                <div class="categories">
                    <h2>Categories</h2>
                    <input type="checkbox" class="footer-checkbox" id="categories-check">
                    <label for="categories-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <ul>
                        <li>DSLR Cameras</li>
                        <li>Mirrorless Cameras</li>
                        <li>Lenses</li>
                        <li>Tripods</li>
                        <li>Lighting Equipment</li>
                    </ul>
                </div>
                <div class="foot-contact">
                    <h2>Contact Us</h2>
                    <input type="checkbox" class="footer-checkbox" id="contact-check">
                    <label for="contact-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <p><i class="fa-solid fa-phone"></i> +91 7038418286</p>
                    <a href="https://www.instagram.com/sumati.color.lab?igsh=ZHIzam5hc3N6bmdj"><i class="fa-brands fa-instagram"></i> Instagram</a>
                    <a href="mailto:khushallll409@gmail.com"><i class="fa-regular fa-envelope"></i> Gmail</a>
                </div>
                <div class="foot-location">
                    <h2>Our Location</h2>
                    <input type="checkbox" class="footer-checkbox" id="location-check">
                    <label for="location-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3766.527047318591!2d76.77415409999999!3d19.259433299999994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bd019cc2af79f0d%3A0x4d9b3ade4eff331!2sSumati%20Colour%20Lab!5e0!3m2!1sen!2sin!4v1772262216473!5m2!1sen!2sin"
                        style="border:0;" allowfullscreen="" loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
            <div class="footer-bottom">
                <hr>
                <p>Copyright © 2026 Sumati Color Lab. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

    <script src="/js/lens.js"></script>
    <script src="/js/popup.js"></script>
    <script src="/js/user-nav.js"></script>
    <script src="/js/search-autocomplete.js"></script>
    <script src="/js/cart.js" defer></script>
</body>

</html>
