<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Admin — Sumati Colour Lab</title>
    <link rel="stylesheet" href="/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="admin-page">

    <!-- ── Sidebar ──────────────────────────────────────────── -->
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">
                <i class="fa-solid fa-camera"></i>
            </div>
            <div class="sidebar-brand-text">
                <h2>Sumati Lab</h2>
                <span>Admin Panel</span>
            </div>
        </div>
        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Main</div>
            <a href="/admin/dashboard" class="sidebar-link active">
                <i class="fa-solid fa-chart-pie"></i> Dashboard
            </a>
            <a href="/admin/products" class="sidebar-link">
                <i class="fa-solid fa-box"></i> Products
            </a>
            <a href="/admin/orders" class="sidebar-link">
                <i class="fa-solid fa-receipt"></i> Orders
            </a>
            <div class="sidebar-section-label">Store</div>
            <a href="/" class="sidebar-link" target="_blank">
                <i class="fa-solid fa-store"></i> View Store
            </a>
        </nav>
        <div class="sidebar-footer">
            <a href="/admin/logout" class="sidebar-link">
                <i class="fa-solid fa-right-from-bracket"></i> Log Out
            </a>
        </div>
    </aside>

    <!-- ── Main Content ─────────────────────────────────────── -->
    <main class="admin-main">
        <div class="admin-topbar">
            <div style="display:flex;align-items:center;gap:0.75rem;">
                <button class="sidebar-toggle" onclick="document.getElementById('adminSidebar').classList.toggle('open')">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="topbar-title">
                    <h1>Dashboard</h1>
                    <p>Welcome back, <%= adminName %></p>
                </div>
            </div>
        </div>

        <div class="admin-content">

            <!-- ── Stats Cards ──────────────────────────────── -->
            <div class="stats-grid">
                <div class="stat-card accent">
                    <div class="stat-card-header">
                        <span class="stat-card-label">Total Products</span>
                        <div class="stat-card-icon">
                            <i class="fa-solid fa-box"></i>
                        </div>
                    </div>
                    <div class="stat-card-value"><%= totalProducts %></div>
                    <div class="stat-card-sub">
                        <% categoryStats.forEach(function(cat) { %>
                            <%= cat._id %>: <%= cat.count %>&nbsp;&nbsp;
                        <% }) %>
                    </div>
                </div>

                <div class="stat-card info">
                    <div class="stat-card-header">
                        <span class="stat-card-label">Total Orders</span>
                        <div class="stat-card-icon">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                    </div>
                    <div class="stat-card-value"><%= totalOrders %></div>
                    <div class="stat-card-sub">
                        <% statusStats.forEach(function(s) { %>
                            <%= s._id %>: <%= s.count %>&nbsp;&nbsp;
                        <% }) %>
                    </div>
                </div>

                <div class="stat-card success">
                    <div class="stat-card-header">
                        <span class="stat-card-label">Revenue</span>
                        <div class="stat-card-icon">
                            <i class="fa-solid fa-indian-rupee-sign"></i>
                        </div>
                    </div>
                    <div class="stat-card-value">₹<%= totalRevenue.toLocaleString('en-IN') %></div>
                    <div class="stat-card-sub">Excluding cancelled orders</div>
                </div>

                <div class="stat-card warning">
                    <div class="stat-card-header">
                        <span class="stat-card-label">Categories</span>
                        <div class="stat-card-icon">
                            <i class="fa-solid fa-tags"></i>
                        </div>
                    </div>
                    <div class="stat-card-value"><%= categoryStats.length %></div>
                    <div class="stat-card-sub">Active product categories</div>
                </div>
            </div>

            <!-- ── Recent Orders Table ──────────────────────── -->
            <div class="admin-table-wrap">
                <div class="admin-table-header">
                    <h2>Recent Orders</h2>
                    <a href="/admin/orders" class="btn btn-secondary btn-sm">View All</a>
                </div>

                <% if (recentOrders.length === 0) { %>
                    <div class="empty-state">
                        <i class="fa-solid fa-receipt"></i>
                        <h3>No orders yet</h3>
                        <p>Orders will appear here once customers start placing them.</p>
                    </div>
                <% } else { %>
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Location</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentOrders.forEach(function(order) { %>
                                <tr>
                                    <td style="font-family:monospace;font-size:0.78rem;color:var(--admin-text-dim);">
                                        #<%= order._id.toString().slice(-6).toUpperCase() %>
                                    </td>
                                    <td><%= order.customerName %></td>
                                    <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                        <%= order.shippingAddress || '—' %>
                                    </td>
                                    <td style="font-weight:600;">₹<%= order.totalAmount.toLocaleString('en-IN') %></td>
                                    <td>
                                        <span class="status-badge <%= order.status %>"><%= order.status %></span>
                                    </td>
                                    <td style="color:var(--admin-text-dim);font-size:0.82rem;">
                                        <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %>
                                    </td>
                                    <td>
                                        <a href="/admin/orders/<%= order._id %>" class="btn btn-secondary btn-sm">View</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>

        </div>
    </main>

</body>

</html>
