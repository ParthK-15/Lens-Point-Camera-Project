<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accessories — Sumati Color Lab</title>
    <link rel="stylesheet" href="/css/accessories.css">
    <link rel="stylesheet" href="/css/user-nav.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="/js/cart-sync-head.js"></script>
</head>

<body>
    <header>
        <nav>
            <div class="navigation">
                <a href="/" class="nav-logo-link" title="Home"><img src="/assets/images/logo.jpeg" alt="Sumati Colour Lab Logo" class="nav-logo-img"></a>
                <a href="/products">Camera</a>
                <a href="/lenses">Lens</a>
                <a href="/accessories" class="active">Accessories</a>
                <a href="#" class="cart-anchor" title="Cart">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="cart-count">0</span>
                </a>
                <div class="options">
                    <input type="text" placeholder="Search">
                    <label>
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </label>
                    <% if (user) { %>
                        <button type="button" class="login" onclick="window.location='/auth/logout'"><%= user.name %></button>
                    <% } else { %>
                        <button type="button" class="login" onclick="window.location='/auth/login'">Log In</button>
                    <% } %>
                </div>
            </div>
        </nav>
    </header>

    <aside>
        <input type="checkbox" id="check">
        <div class="btn_one">
            <label for="check">
                <i class="fa-solid fa-bars"></i>
            </label>
        </div>
        <div class="mainbox">
            <div class="btn_two">
                <label for="check">
                    <i class="fa-solid fa-xmark"></i>
                </label>
            </div>
            <div class="sidebar">
                <div class="head">
                    <a href="/"><img src="/assets/images/logo.jpeg" alt="Sumati Colour Lab Logo" class="mobile-menu-logo"></a>
                </div>
                <hr>
                <div class="sidebar_menu">
                    <a href="/">Home</a>
                    <a href="/products">Camera</a>
                    <a href="/lenses">Lens</a>
                    <a href="/accessories">Accessories</a>
                    <a href="#" class="cart-anchor-mobile">
                        <i class="fa-solid fa-cart-shopping"></i> Cart
                        <span class="cart-count-mobile">0</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="searchIcon">
            <input type="text" placeholder="Search" class="inputMobile">
            <label for="input">
                <i class="fa-solid fa-magnifying-glass" id="searchButton"></i>
            </label>
            <% if (user) { %>
                <button class="login2" onclick="window.location='/auth/logout'"><%= user.name %></button>
            <% } else { %>
                <button class="login2" onclick="window.location='/auth/login'">Log In</button>
            <% } %>
        </div>
    </aside>

    <main>
        <div class="main-accessories-screen">
            <div class="main-accessories-cards">
                <a href="/category/tripod">
                    <div class="accessories-cards">
                        <div class="accessories-img-container">
                            <img src="/assets/images/images1_nobg.png" alt="Tripod">
                        </div>
                        <h2>Tripod</h2>
                        <div class="accessories-card-footer">
                            <button>Explore</button>
                        </div>
                    </div>
                </a>
                <a href="/category/gimbal">
                    <div class="accessories-cards">
                        <div class="accessories-img-container">
                            <img src="/assets/images/gimbal-manfrotto-mvg460-with-camera.jpg_nobg.png" alt="Gimbal">
                        </div>
                        <h2>Gimbal</h2>
                        <div class="accessories-card-footer">
                            <button>Explore</button>
                        </div>
                    </div>
                </a>
                <a href="/category/lighting">
                    <div class="accessories-cards">
                        <div class="accessories-img-container">
                            <img src="/assets/images/professional-photography-studio-lighting-equipment-tripod_191095-77846-Photoroom_nobg.png" alt="Lightings">
                        </div>
                        <h2>Lightings</h2>
                        <div class="accessories-card-footer">
                            <button>Explore</button>
                        </div>
                    </div>
                </a>
                <a href="/category/microphone">
                    <div class="accessories-cards">
                        <div class="accessories-img-container">
                            <img src="/assets/images/images2_nobg.png" alt="Microphones">
                        </div>
                        <h2>Microphones</h2>
                        <div class="accessories-card-footer">
                            <button>Explore</button>
                        </div>
                    </div>
                </a>
                <a href="/category/storage">
                    <div class="accessories-cards">
                        <div class="accessories-img-container">
                            <img src="/assets/images/extreme-pro-uhs-ii-sd-128gb-front.png.thumb.1280.1280.png" alt="Storage">
                        </div>
                        <h2>Storage</h2>
                        <div class="accessories-card-footer">
                            <button>Explore</button>
                        </div>
                    </div>
                </a>
                <a href="/category/bag">
                    <div class="accessories-cards">
                        <div class="accessories-img-container">
                            <img src="/assets/images/2-1546892890000_img_491566_nobg.png" alt="Bag-packs">
                        </div>
                        <h2>Bag Packs</h2>
                        <div class="accessories-card-footer">
                            <button>Explore</button>
                        </div>
                    </div>
                </a>
                <a href="/category/battery">
                    <div class="accessories-cards">
                        <div class="accessories-img-container">
                            <img src="/assets/images/battery.png" alt="Batteries">
                        </div>
                        <h2>Batteries</h2>
                        <div class="accessories-card-footer">
                            <button>Explore</button>
                        </div>
                    </div>
                </a>
                <a href="/category/film">
                    <div class="accessories-cards">
                        <div class="accessories-img-container">
                            <img src="/assets/images/0053767_fujifilm-instax-square-monochrome-instant-film-10-exposures_360_nobg.png" alt="films-albums">
                        </div>
                        <h2>Films & Albums</h2>
                        <div class="accessories-card-footer">
                            <button>Explore</button>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </main>

    <footer>
        <div class="footer-main">
            <div class="main-footer">
                <div class="brands">
                    <h2>Brands</h2>
                    <input type="checkbox" class="footer-checkbox" id="brands-check">
                    <label for="brands-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <ul>
                        <li>Sony</li>
                        <li>Canon</li>
                        <li>Nikon</li>
                        <li>Fujifilm</li>
                        <li>GoPro</li>
                    </ul>
                </div>
                <div class="categories">
                    <h2>Categories</h2>
                    <input type="checkbox" class="footer-checkbox" id="categories-check">
                    <label for="categories-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <ul>
                        <li>DSLR Cameras</li>
                        <li>Mirrorless Cameras</li>
                        <li>Lenses</li>
                        <li>Tripods</li>
                        <li>Lighting Equipment</li>
                    </ul>
                </div>
                <div class="foot-contact">
                    <h2>Contact Us</h2>
                    <input type="checkbox" class="footer-checkbox" id="contact-check">
                    <label for="contact-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <p><i class="fa-solid fa-phone"></i> +91 7038418286</p>
                    <a href="https://www.instagram.com/sumati.color.lab?igsh=ZHIzam5hc3N6bmdj"><i class="fa-brands fa-instagram"></i> Instagram</a>
                    <a href="mailto:khushallll409@gmail.com"><i class="fa-regular fa-envelope"></i> Gmail</a>
                </div>
                <div class="foot-location">
                    <h2>Our Location</h2>
                    <input type="checkbox" class="footer-checkbox" id="location-check">
                    <label for="location-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3766.527047318591!2d76.77415409999999!3d19.259433299999994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bd019cc2af79f0d%3A0x4d9b3ade4eff331!2sSumati%20Colour%20Lab!5e0!3m2!1sen!2sin!4v1772262216473!5m2!1sen!2sin"
                        style="border:0;" allowfullscreen="" loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
            <div class="footer-bottom">
                <hr>
                <p>Copyright © 2026 Sumati Color Lab. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        (function() {
            function routeSearch(input) {
                if (!input) return;
                var q = input.value.trim();
                if (!q) return;
                window.location.href = '/search?q=' + encodeURIComponent(q);
            }
            document.addEventListener('DOMContentLoaded', function() {
                var di = document.querySelector('.options input[type="text"]');
                var dIcon = document.querySelector('.options i.fa-magnifying-glass');
                var mi = document.querySelector('.inputMobile');
                var mIcon = document.getElementById('searchButton');
                if (di) di.addEventListener('keydown', function(e) { if (e.key === 'Enter') routeSearch(di); });
                if (dIcon) dIcon.addEventListener('click', function() { routeSearch(di); });
                if (mi) mi.addEventListener('keydown', function(e) { if (e.key === 'Enter') routeSearch(mi); });
                if (mIcon) mIcon.addEventListener('click', function() { routeSearch(mi); });
            });
        })();
    </script>
    <script src="/js/accessories.js"></script>
    <script src="/js/popup.js"></script>
    <script src="/js/user-nav.js"></script>
    <script src="/js/cart.js" defer></script>
</body>

</html>
