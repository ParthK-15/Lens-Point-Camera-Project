<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in with Apple — Sumati Color Lab</title>
    <link rel="stylesheet" href="/css/auth.css">
</head>

<body style="background: #000; color: #fff; font-family: -apple-system, BlinkMacSystemFont, sans-serif;">
    <div class="auth-card" style="background: #111; color: #fff;">
        <i class="fa-brands fa-apple" style="font-size: 3rem; margin-bottom: 1rem;"></i>
        <h2>Sign in with Apple ID</h2>
        <form action="/auth/apple/callback" method="POST">
            <div class="form-group">
                <label for="email" style="color: #ccc;">Apple ID Email</label>
                <input type="email" id="email" name="email" value="apple.user@example.com" required style="background: #222; color: #fff; border: 1px solid #444;">
            </div>
            <div class="form-group">
                <label for="name" style="color: #ccc;">Name</label>
                <input type="text" id="name" name="name" value="Apple User" required style="background: #222; color: #fff; border: 1px solid #444;">
            </div>
            <input type="hidden" name="appleId" value="apple-mock-id-12345">
            <input type="hidden" name="returnTo" value="<%= returnTo %>">
            <button type="submit" class="auth-btn" style="background: #fff; color: #000;">Continue</button>
        </form>
    </div>
</body>

</html>
