<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up — Sumati Color Lab</title>
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="auth-page">
    <div class="auth-container">
        <!-- Brand Panel (Left) -->
        <div class="auth-brand-panel">
            <div class="auth-brand-content">
                <div class="auth-brand-icon">
                    <i class="fa-solid fa-camera-retro"></i>
                </div>
                <h1 class="auth-brand-title">Sumati Color Lab</h1>
                <p class="auth-brand-subtitle">Create an account to track orders, save items to your wishlist, and enjoy instant checkout.</p>
                <div class="auth-brand-features">
                    <div class="auth-brand-feature">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>100% Genuine Certified Gear</span>
                    </div>
                    <div class="auth-brand-feature">
                        <i class="fa-solid fa-truck-fast"></i>
                        <span>Free Express Shipping Worldwide</span>
                    </div>
                    <div class="auth-brand-feature">
                        <i class="fa-solid fa-headset"></i>
                        <span>24/7 Expert Photography Support</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Panel (Right) -->
        <div class="auth-form-panel">
            <a href="/" class="auth-back-link"><i class="fa-solid fa-arrow-left"></i> Back to Store</a>

            <div class="auth-form-wrapper">
                <div class="auth-form-header">
                    <h1>Create Account</h1>
                    <p>Join thousands of professional photographers today.</p>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="auth-alert auth-alert-error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <!-- Google Sign-In Button -->
                <div class="auth-social-buttons">
                    <a href="/auth/google" class="auth-social-btn google">
                        <svg viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                        </svg>
                        <span>Sign up with Google</span>
                    </a>
                </div>

                <div class="auth-divider">
                    <span>or register with email</span>
                </div>

                <form action="/auth/signup" method="POST" class="auth-form">
                    <div class="auth-input-group">
                        <label for="name">Full Name</label>
                        <div class="auth-input-wrap">
                            <input type="text" id="name" name="name" placeholder="John Doe" required>
                            <i class="fa-solid fa-user input-icon"></i>
                        </div>
                    </div>

                    <div class="auth-input-group">
                        <label for="email">Email Address</label>
                        <div class="auth-input-wrap">
                            <input type="email" id="email" name="email" placeholder="name@example.com" required>
                            <i class="fa-solid fa-envelope input-icon"></i>
                        </div>
                    </div>

                    <div class="auth-input-group">
                        <label for="phone">Phone Number (Optional)</label>
                        <div class="auth-input-wrap">
                            <input type="tel" id="phone" name="phone" placeholder="+91 98765 43210">
                            <i class="fa-solid fa-phone input-icon"></i>
                        </div>
                    </div>

                    <div class="auth-input-group">
                        <label for="location">Location / City (Optional)</label>
                        <div class="auth-input-wrap">
                            <input type="text" id="location" name="location" placeholder="e.g. Mumbai, Maharashtra">
                            <i class="fa-solid fa-location-dot input-icon"></i>
                        </div>
                    </div>

                    <div class="auth-input-group">
                        <label for="password">Password</label>
                        <div class="auth-input-wrap">
                            <input type="password" id="password" name="password" placeholder="Min. 6 characters" required>
                            <i class="fa-solid fa-lock input-icon"></i>
                            <button type="button" class="password-toggle" onclick="togglePasswordVisibility('password', this)">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="auth-input-group">
                        <label for="confirmPassword">Confirm Password</label>
                        <div class="auth-input-wrap">
                            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password" required>
                            <i class="fa-solid fa-shield-halved input-icon"></i>
                        </div>
                    </div>

                    <button type="submit" class="auth-submit-btn">Create Account</button>
                </form>

                <div class="auth-footer">
                    <p>Already have an account? <a href="/auth/login">Log In</a></p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fa-regular fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fa-regular fa-eye';
            }
        }
    </script>
</body>

</html>
