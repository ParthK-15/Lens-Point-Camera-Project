<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Placed Successfully | Sumati Colour Lab</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --success-bg: #f9fafb;
            --success-surface: #ffffff;
            --success-text: #111827;
            --success-text-muted: #6b7280;
            --success-border: #e5e7eb;
            --success-accent: #22c55e;
            --success-brand: #ff6b00;
            --success-radius: 16px;
        }

        body {
            background-color: rgb(187, 184, 184);
            font-family: 'Inter', sans-serif;
            color: var(--success-text);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .success-container {
            max-width: 650px;
            margin: 0 auto;
            padding: 4rem 1.5rem;
            text-align: center;
            flex-grow: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: transparent !important;
            box-sizing: border-box;
        }

        .success-card {
            background: var(--success-surface);
            border: 1px solid var(--success-border);
            border-radius: var(--success-radius);
            padding: 3.5rem 2.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            width: 100%;
        }

        .success-icon-wrap {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background-color: rgba(34, 197, 94, 0.1);
            color: var(--success-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            margin: 0 auto 1.5rem;
            animation: iconBounce 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes iconBounce {
            0% { transform: scale(0.3); opacity: 0; }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }

        .success-title {
            font-size: 1.8rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            color: var(--success-text);
        }

        .success-subtitle {
            font-size: 0.95rem;
            color: var(--success-text-muted);
            margin-bottom: 2rem;
            line-height: 1.5;
        }

        .order-details-card {
            background-color: var(--success-bg);
            border: 1px dashed var(--success-border);
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
            text-align: left;
            margin-bottom: 2rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.88rem;
        }

        .detail-label {
            color: var(--success-text-muted);
            font-weight: 500;
        }

        .detail-value {
            color: var(--success-text);
            font-weight: 600;
        }

        .detail-value.order-id {
            font-family: monospace;
            font-size: 0.95rem;
            color: var(--success-brand);
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
        }

        .btn-success {
            flex: 1;
            padding: 0.9rem;
            border-radius: 10px;
            font-family: inherit;
            font-weight: 700;
            font-size: 0.92rem;
            cursor: pointer;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            border: none;
        }

        .btn-success.primary {
            background: linear-gradient(135deg, var(--success-brand), #ff8c33);
            color: #fff;
        }

        .btn-success.primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(255, 107, 0, 0.25);
        }

        .btn-success.secondary {
            background-color: var(--success-surface);
            border: 1.5px solid var(--success-border);
            color: var(--success-text);
        }

        .btn-success.secondary:hover {
            background-color: var(--success-bg);
        }
    </style>
</head>

<body>

    <header style="background-color: #000; height: 4rem; display: flex; align-items: center;">
        <nav style="width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;">
            <a href="/index.html" style="color: #fff; text-decoration: none; font-weight: 700; font-size: 1.2rem;">Sumati Colour Lab</a>
        </nav>
    </header>

    <main class="success-container">
        <div class="success-card">
            <div class="success-icon-wrap">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <h1 class="success-title">Order Confirmed!</h1>
            <p class="success-subtitle">
                Thank you for your purchase. We have received your order and are preparing it for shipment.
            </p>

            <div class="order-details-card">
                <div class="detail-row">
                    <span class="detail-label">Order ID</span>
                    <span class="detail-value order-id"><%= order._id %></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Customer Name</span>
                    <span class="detail-value"><%= order.customerName %></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Total Amount</span>
                    <span class="detail-value" style="color: var(--success-brand);">₹<%= order.totalAmount.toLocaleString('en-IN') %>/-</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Shipping To</span>
                    <span class="detail-value" style="text-align: right; max-width: 60%;"><%= order.shippingAddress %></span>
                </div>
            </div>

            <div class="action-buttons">
                <a href="/index.html" class="btn-success primary">
                    <i class="fa-solid fa-bag-shopping"></i> Continue Shopping
                </a>
            </div>
        </div>
    </main>

    <footer style="background-color: #111; padding: 1.5rem 0; text-align: center; border-top: 1px solid #222;">
        <p style="color: #666; font-size: 0.8rem; margin: 0;">Copyright © 2026 Sumati Color Lab. All Rights Reserved.</p>
    </footer>

</body>

</html>
