<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | Sumati Colour Lab</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/user-nav.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --chk-bg: #f9fafb;
            --chk-surface: #ffffff;
            --chk-text: #111827;
            --chk-text-muted: #6b7280;
            --chk-border: #e5e7eb;
            --chk-accent: #ff6b00;
            --chk-accent-hover: #e85d00;
            --chk-accent-glow: rgba(255, 107, 0, 0.15);
            --chk-radius: 12px;
            --chk-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        body {
            background-color: rgb(187, 184, 184);
            font-family: 'Inter', sans-serif;
            color: var(--chk-text);
        }

        .checkout-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 3rem 1.5rem 8rem;
            min-height: calc(100vh - 4rem);
            box-sizing: border-box;
        }

        .checkout-title-row {
            margin-bottom: 2rem;
        }

        .checkout-title-row h1 {
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--chk-text);
        }

        .checkout-layout {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 2.5rem;
            align-items: start;
        }

        /* ── Left Section: Shipping Form ── */
        .checkout-form-section {
            background: var(--chk-surface);
            border: 1px solid var(--chk-border);
            border-radius: var(--chk-radius);
            padding: 2.5rem;
            box-shadow: var(--chk-shadow);
        }

        .checkout-section-title {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: var(--chk-text);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border-bottom: 2px solid var(--chk-bg);
            padding-bottom: 0.75rem;
        }

        .checkout-section-title i {
            color: var(--chk-accent);
        }

        .checkout-form {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .form-row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
        }

        .checkout-input-group {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .checkout-input-group label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--chk-text);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .checkout-input-group input,
        .checkout-input-group textarea {
            width: 100%;
            padding: 0.8rem 1rem;
            border: 1.5px solid var(--chk-border);
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.92rem;
            color: var(--chk-text);
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            box-sizing: border-box;
        }

        .checkout-input-group textarea {
            resize: vertical;
            min-height: 100px;
        }

        .checkout-input-group input:focus,
        .checkout-input-group textarea:focus {
            border-color: var(--chk-accent);
            box-shadow: 0 0 0 3px var(--chk-accent-glow);
        }

        /* Payment Methods */
        .payment-methods {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-top: 0.5rem;
        }

        .payment-method-card {
            border: 1.5px solid var(--chk-border);
            border-radius: 10px;
            padding: 1rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            cursor: pointer;
            transition: border-color 0.2s, background-color 0.2s;
        }

        .payment-method-card:hover {
            background-color: var(--chk-bg);
        }

        .payment-method-card input[type="radio"] {
            accent-color: var(--chk-accent);
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .payment-method-card.active {
            border-color: var(--chk-accent);
            background-color: rgba(255, 107, 0, 0.02);
        }

        .payment-method-info {
            display: flex;
            flex-direction: column;
        }

        .payment-method-title {
            font-size: 0.92rem;
            font-weight: 600;
            color: var(--chk-text);
        }

        .payment-method-desc {
            font-size: 0.78rem;
            color: var(--chk-text-muted);
        }

        /* ── Right Section: Order Summary ── */
        .checkout-summary-section {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            position: sticky;
            top: 2rem;
        }

        .checkout-summary-card {
            background: var(--chk-surface);
            border: 1px solid var(--chk-border);
            border-radius: var(--chk-radius);
            padding: 2rem;
            box-shadow: var(--chk-shadow);
        }

        .summary-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 1.25rem;
            color: var(--chk-text);
        }

        .summary-items-list {
            max-height: 240px;
            overflow-y: auto;
            margin-bottom: 1.5rem;
            border-bottom: 1px solid var(--chk-border);
            padding-bottom: 1rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .summary-item-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .summary-item-row img {
            width: 48px;
            height: 48px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid var(--chk-border);
            background-color: var(--chk-bg);
        }

        .summary-item-info {
            flex: 1;
            min-width: 0;
        }

        .summary-item-name {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--chk-text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .summary-item-qty {
            font-size: 0.75rem;
            color: var(--chk-text-muted);
        }

        .summary-item-price {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--chk-text);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.88rem;
            color: var(--chk-text-muted);
            margin-bottom: 0.75rem;
        }

        .summary-row.total-row {
            border-top: 1px dashed var(--chk-border);
            margin-top: 1rem;
            padding-top: 1rem;
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--chk-text);
        }

        .place-order-btn {
            width: 100%;
            padding: 1rem;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--chk-accent), #ff8c33);
            color: #fff;
            font-family: inherit;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            margin-top: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .place-order-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(255, 107, 0, 0.3);
        }

        .place-order-btn:active {
            transform: translateY(0);
        }

        @media (max-width: 850px) {
            .checkout-layout {
                grid-template-columns: 1fr;
            }

            .checkout-summary-section {
                position: static;
            }
        }

        /* ── Mock Payment Gateway Styles ── */
        .payment-portal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(8px);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .payment-portal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .payment-portal-modal {
            background: #ffffff;
            width: 100%;
            max-width: 440px;
            border-radius: 16px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            position: relative;
            transform: translateY(30px);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            padding: 1.75rem;
            box-sizing: border-box;
            color: var(--chk-text);
        }

        .payment-portal-overlay.active .payment-portal-modal {
            transform: translateY(0);
        }

        .portal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--chk-border);
            margin-bottom: 1.25rem;
        }

        .merchant-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .secure-icon {
            font-size: 1.5rem;
            color: #ff6b00;
        }

        .merchant-info h3 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }

        .secure-label {
            font-size: 0.7rem;
            color: #22c55e;
            font-weight: 600;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.2rem;
        }

        .portal-close {
            background: none;
            border: none;
            font-size: 1.75rem;
            color: var(--chk-text-muted);
            cursor: pointer;
            padding: 0;
            line-height: 1;
        }

        .portal-close:hover {
            color: var(--chk-text);
        }

        .portal-amount-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
            padding: 0.85rem 1.25rem;
            border-radius: 10px;
            margin-bottom: 1.25rem;
            font-size: 0.9rem;
            color: var(--chk-text-muted);
        }

        .portal-amount {
            font-size: 1.15rem;
            font-weight: 800;
            color: #ff6b00;
        }

        .portal-tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1.25rem;
            border-bottom: 2px solid var(--chk-border);
            padding-bottom: 0.25rem;
        }

        .portal-tab {
            flex: 1;
            padding: 0.75rem;
            border: none;
            background: none;
            font-family: inherit;
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--chk-text-muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .portal-tab:hover {
            background: #f1f5f9;
            color: var(--chk-text);
        }

        .portal-tab.active {
            color: #ff6b00;
            background: rgba(255, 107, 0, 0.08);
        }

        .portal-tab-content {
            display: none;
        }

        .portal-tab-content.active {
            display: block;
        }

        .portal-input-group {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            margin-bottom: 1rem;
            text-align: left;
        }

        .portal-input-group label {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--chk-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .portal-input-group input {
            padding: 0.75rem 1rem;
            border: 1.5px solid var(--chk-border);
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.92rem;
            color: var(--chk-text);
            outline: none;
            transition: border-color 0.2s;
            width: 100%;
            box-sizing: border-box;
        }

        .portal-input-group input:focus {
            border-color: #ff6b00;
        }

        .portal-row {
            display: flex;
            gap: 1rem;
        }

        .card-brand-icon {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1.25rem;
            color: var(--chk-text-muted);
            pointer-events: none;
        }

        .upi-qr-section {
            display: flex;
            justify-content: center;
            padding: 0.5rem 0 1rem;
        }

        .upi-qr-box {
            text-align: center;
            background: #f8fafc;
            border: 1px solid var(--chk-border);
            border-radius: 12px;
            padding: 1.25rem;
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
        }

        .qr-label {
            font-size: 0.75rem;
            color: var(--chk-text-muted);
            margin: 0;
            font-weight: 500;
        }

        .portal-pay-btn {
            width: 100%;
            padding: 0.95rem;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, #ff6b00, #ff8c33);
            color: #fff;
            font-family: inherit;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            margin-top: 0.75rem;
            box-shadow: 0 4px 15px rgba(255, 107, 0, 0.2);
        }

        .portal-pay-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(255, 107, 0, 0.35);
        }

        .portal-footer {
            text-align: center;
            font-size: 0.72rem;
            color: var(--chk-text-muted);
            margin-top: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
        }

        /* ── Processing screen ── */
        .portal-processing-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #ffffff;
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            box-sizing: border-box;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .portal-processing-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .processing-spinner {
            width: 50px;
            height: 50px;
            border: 4px solid rgba(255, 107, 0, 0.1);
            border-top: 4px solid #ff6b00;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin-bottom: 1.5rem;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .portal-processing-overlay h4 {
            margin: 0 0 0.5rem;
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--chk-text);
        }

        .portal-processing-overlay p {
            margin: 0;
            font-size: 0.82rem;
            color: var(--chk-text-muted);
        }

        /* ── Checkmark Animation ── */
        .success-checkmark {
            width: 80px;
            height: 80px;
            margin-bottom: 1.5rem;
            display: none;
        }

        .success-checkmark.active {
            display: block;
        }

        .success-checkmark .check-icon {
            width: 80px;
            height: 80px;
            position: relative;
            border-radius: 50%;
            box-sizing: content-box;
            border: 4px solid #4CAF50;
        }

        .success-checkmark .check-icon::before, .success-checkmark .check-icon::after {
            content: '';
            height: 100px;
            position: absolute;
            background: #FFFFFF;
            transform: rotate(-45deg);
        }

        .success-checkmark .check-icon::before {
            border-radius: 100px 0 0 100px;
            top: -7px;
            left: -33px;
            width: 30px;
            transform-origin: 100% 50%;
        }

        .success-checkmark .check-icon::after {
            border-radius: 0 100px 100px 0;
            top: -30px;
            left: 30px;
            width: 60px;
            transform-origin: 0 50%;
        }

        .success-checkmark .check-icon .icon-line {
            height: 5px;
            background-color: #4CAF50;
            display: block;
            border-radius: 2px;
            position: absolute;
            z-index: 10;
        }

        .success-checkmark .check-icon .icon-line.line-tip {
            top: 46px;
            left: 19px;
            width: 25px;
            transform: rotate(45deg);
            animation: icon-line-tip 0.75s;
        }

        .success-checkmark .check-icon .icon-line.line-long {
            top: 38px;
            right: 14px;
            width: 47px;
            transform: rotate(-45deg);
            animation: icon-line-long 0.75s;
        }

        .success-checkmark .check-icon .icon-circle {
            top: -4px;
            left: -4px;
            position: absolute;
            z-index: 10;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 4px solid rgba(76, 175, 80, 0.5);
            box-sizing: content-box;
        }

        .success-checkmark .check-icon .icon-fix {
            top: 8px;
            left: 28px;
            width: 5px;
            height: 85px;
            position: absolute;
            z-index: 1;
            transform: rotate(-45deg);
        }

        @keyframes icon-line-tip {
            0% { width: 0; top: 19px; left: 6px; }
            54% { width: 0; top: 19px; left: 6px; }
            70% { width: 50px; top: 37px; left: 8px; }
            84% { width: 17px; top: 48px; left: 21px; }
            100% { width: 25px; top: 46px; left: 19px; }
        }

        @keyframes icon-line-long {
            0% { width: 0; top: 54px; right: 46px; }
            65% { width: 0; top: 54px; right: 46px; }
            84% { width: 55px; top: 35px; right: 0px; }
            100% { width: 47px; top: 38px; right: 14px; }
        }
    </style>
</head>

<body>

    <header style="background-color: #000; height: 4rem; display: flex; align-items: center;">
        <nav style="width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <a href="/index.html" style="color: #fff; text-decoration: none; font-weight: 700; font-size: 1.2rem;">Sumati Colour Lab</a>
            <a href="/cart.html" style="color: rgba(255,255,255,0.7); text-decoration: none; font-size: 0.9rem;"><i class="fa-solid fa-arrow-left"></i> Back to Cart</a>
        </nav>
    </header>

    <main class="checkout-container">
        <div class="checkout-title-row">
            <h1>Checkout</h1>
        </div>

        <form class="checkout-layout" id="checkoutForm" action="/checkout" method="POST">
            <!-- Hidden inputs to submit cart items & totals -->
            <input type="hidden" name="cartData" id="hiddenCartData">
            <input type="hidden" name="totalAmount" id="hiddenTotalAmount">

            <!-- Left: Shipping & Payment Form -->
            <div class="checkout-form-section">
                
                <div class="checkout-section-title">
                    <i class="fa-solid fa-truck-fast"></i>
                    <span>Shipping Address</span>
                </div>

                <div class="checkout-form">
                    <div class="checkout-input-group">
                        <label for="shipping-name">Full Name</label>
                        <input type="text" id="shipping-name" name="customerName" 
                            value="<%= user ? user.name : '' %>" required placeholder="Enter recipient's full name">
                    </div>

                    <div class="form-row-2">
                        <div class="checkout-input-group">
                            <label for="shipping-email">Email Address</label>
                            <input type="email" id="shipping-email" name="customerEmail" 
                                value="<%= user ? user.email : '' %>" required placeholder="recipient@example.com">
                        </div>
                        <div class="checkout-input-group">
                            <label for="shipping-phone">Phone Number</label>
                            <input type="tel" id="shipping-phone" name="customerPhone" 
                                value="<%= user ? user.phone : '' %>" required placeholder="e.g. 9876543210">
                        </div>
                    </div>

                    <div class="checkout-input-group">
                        <label for="shipping-address">Full Address</label>
                        <textarea id="shipping-address" name="shippingAddress" required 
                            placeholder="Apartment, Street name, Landmark, City, State, Pincode"><%= user ? user.address : '' %></textarea>
                    </div>

                    <div class="checkout-input-group">
                        <label for="order-notes">Order Notes (Optional)</label>
                        <textarea id="order-notes" name="notes" placeholder="Notes about your delivery, e.g. special instructions for delivery."></textarea>
                    </div>
                </div>

                <div class="checkout-section-title" style="margin-top: 2.5rem;">
                    <i class="fa-solid fa-credit-card"></i>
                    <span>Payment Method</span>
                </div>

                <div class="payment-methods">
                    <div class="payment-method-card active" onclick="selectPaymentMethod(this)">
                        <input type="radio" name="paymentMethod" value="COD" checked>
                        <div class="payment-method-info">
                            <span class="payment-method-title">Cash on Delivery (COD)</span>
                            <span class="payment-method-desc">Pay in cash or UPI upon delivery of your gear.</span>
                        </div>
                    </div>
                    <div class="payment-method-card" onclick="selectPaymentMethod(this)">
                        <input type="radio" name="paymentMethod" value="ONLINE">
                        <div class="payment-method-info">
                            <span class="payment-method-title">Online Payment (Mock)</span>
                            <span class="payment-method-desc">Simulated card/UPI transfer. No actual charges.</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right: Order Summary -->
            <div class="checkout-summary-section">
                <div class="checkout-summary-card">
                    <h2 class="summary-title">Order Summary</h2>
                    
                    <div class="summary-items-list" id="checkoutItemsList">
                        <!-- Items rendered from localStorage -->
                    </div>

                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span id="summarySubtotal">₹0/-</span>
                    </div>
                    <div class="summary-row">
                        <span>Delivery Charges</span>
                        <span style="color: #22c55e; font-weight: 600;">FREE</span>
                    </div>
                    <div class="summary-row total-row">
                        <span>Total Amount</span>
                        <span id="summaryTotal">₹0/-</span>
                    </div>

                    <button type="submit" class="place-order-btn" id="placeOrderBtn">
                        <i class="fa-solid fa-bag-shopping"></i> Place Order
                    </button>
                </div>
            </div>
        </form>
    </main>

    <script src="/user-nav.js"></script>
    <script>
        function selectPaymentMethod(card) {
            document.querySelectorAll('.payment-method-card').forEach(c => c.classList.remove('active'));
            card.classList.add('active');
            card.querySelector('input[type="radio"]').checked = true;
        }

        // Render summary items from localStorage cart
        document.addEventListener('DOMContentLoaded', () => {
            const cart = JSON.parse(localStorage.getItem('cart') || '[]');
            const listContainer = document.getElementById('checkoutItemsList');
            const subtotalEl = document.getElementById('summarySubtotal');
            const totalEl = document.getElementById('summaryTotal');

            if (cart.length === 0) {
                // If cart is empty, redirect back to home page
                alert('Your cart is empty. Please add items to your cart before checking out.');
                window.location.href = '/index.html';
                return;
            }

            let totalSum = 0;
            listContainer.innerHTML = '';

            cart.forEach(item => {
                const numericPrice = parseInt(item.price.replace(/[^\d]/g, '')) || 0;
                const quantity = item.quantity || 1;
                const itemTotal = numericPrice * quantity;
                totalSum += itemTotal;

                const row = document.createElement('div');
                row.className = 'summary-item-row';
                row.innerHTML = `
                    <img src="${item.image}" alt="${item.title}">
                    <div class="summary-item-info">
                        <div class="summary-item-name">${item.title}</div>
                        <div class="summary-item-qty">Qty: ${quantity}</div>
                    </div>
                    <div class="summary-item-price">₹${itemTotal.toLocaleString('en-IN')}/-</div>
                `;
                listContainer.appendChild(row);
            });

            subtotalEl.innerText = `₹${totalSum.toLocaleString('en-IN')}/-`;
            totalEl.innerText = `₹${totalSum.toLocaleString('en-IN')}/-`;

            // Prepare inputs for form submission
            document.getElementById('hiddenTotalAmount').value = totalSum;
            document.getElementById('hiddenCartData').value = JSON.stringify(cart);

            // Clean up cart on successful submit
            let isPaymentPassed = false;
            const checkoutForm = document.getElementById('checkoutForm');
            const portalOverlay = document.getElementById('paymentPortalOverlay');
            const portalCloseBtn = document.getElementById('closePortalBtn');
            const portalPayBtn = document.getElementById('portalPayBtn');
            const portalAmountText = document.getElementById('portalAmountText');

            // Tabs toggle
            const tabs = document.querySelectorAll('.portal-tab');
            const tabContents = document.querySelectorAll('.portal-tab-content');
            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    tabs.forEach(t => t.classList.remove('active'));
                    tabContents.forEach(tc => tc.classList.remove('active'));
                    
                    tab.classList.add('active');
                    const targetContent = document.getElementById(`tab-content-${tab.dataset.tab}`);
                    if (targetContent) targetContent.classList.add('active');
                });
            });

            // Card formatting auto-spaces
            const cardNumInput = document.getElementById('portalCardNum');
            cardNumInput?.addEventListener('input', (e) => {
                let value = e.target.value.replace(/\D/g, '');
                let formatted = '';
                for (let i = 0; i < value.length; i++) {
                    if (i > 0 && i % 4 === 0) formatted += ' ';
                    formatted += value[i];
                }
                e.target.value = formatted;

                // Brand icon detection
                const brandIcon = document.getElementById('cardBrandIcon');
                if (value.startsWith('4')) {
                    brandIcon.innerHTML = '<i class="fa-brands fa-cc-visa" style="color: #1a1f71;"></i>';
                } else if (value.startsWith('5')) {
                    brandIcon.innerHTML = '<i class="fa-brands fa-cc-mastercard" style="color: #eb001b;"></i>';
                } else {
                    brandIcon.innerHTML = '<i class="fa-regular fa-credit-card"></i>';
                }
            });

            // Expiry auto-slash
            const cardExpiryInput = document.getElementById('portalCardExpiry');
            cardExpiryInput?.addEventListener('input', (e) => {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length > 2) {
                    e.target.value = value.substring(0, 2) + '/' + value.substring(2, 4);
                } else {
                    e.target.value = value;
                }
            });

            checkoutForm.addEventListener('submit', (e) => {
                const selectedMethod = document.querySelector('input[name="paymentMethod"]:checked').value;
                
                if (selectedMethod === 'Online' && !isPaymentPassed) {
                    e.preventDefault();
                    portalAmountText.innerText = document.getElementById('summaryTotal').innerText;
                    portalOverlay.classList.add('active');
                } else {
                    localStorage.removeItem('cart');
                }
            });

            portalCloseBtn.addEventListener('click', () => {
                portalOverlay.classList.remove('active');
            });

            portalPayBtn.addEventListener('click', () => {
                const activeTab = document.querySelector('.portal-tab.active').dataset.tab;
                
                if (activeTab === 'card') {
                    const cardNum = document.getElementById('portalCardNum').value.trim();
                    const cardExp = document.getElementById('portalCardExpiry').value.trim();
                    const cardCvv = document.getElementById('portalCardCvv').value.trim();
                    const cardName = document.getElementById('portalCardName').value.trim();
                    
                    if (cardNum.length < 15) {
                        alert('Please enter a valid card number.');
                        return;
                    }
                    if (cardExp.length < 5) {
                        alert('Please enter a valid expiry date (MM/YY).');
                        return;
                    }
                    if (cardCvv.length < 3) {
                        alert('Please enter a valid CVV.');
                        return;
                    }
                    if (cardName.length < 2) {
                        alert('Please enter the cardholder\'s name.');
                        return;
                    }
                } else {
                    const upiId = document.getElementById('portalUpiId').value.trim();
                    if (!upiId.includes('@')) {
                        alert('Please enter a valid UPI ID (e.g. name@upi).');
                        return;
                    }
                }

                // Show processing overlay
                const processingOverlay = document.getElementById('portalProcessingOverlay');
                const processingSpinner = document.getElementById('processingSpinner');
                const successCheckmark = document.getElementById('successCheckmark');
                const processingTitle = document.getElementById('processingTitle');
                
                processingOverlay.classList.add('active');
                
                setTimeout(() => {
                    processingSpinner.style.display = 'none';
                    successCheckmark.classList.add('active');
                    processingTitle.innerText = 'Payment Successful!';
                    
                    setTimeout(() => {
                        isPaymentPassed = true;
                        // Submit form by calling standard form submission
                        checkoutForm.submit();
                    }, 1200);
                }, 2200);
            });
        });
    </script>

    <!-- ── Mock Payment Gateway Modal Overlay ── -->
    <div class="payment-portal-overlay" id="paymentPortalOverlay">
        <div class="payment-portal-modal">
            <div class="portal-header">
                <div class="merchant-info">
                    <i class="fa-solid fa-shield-halved secure-icon"></i>
                    <div>
                        <h3>Sumati Colour Lab</h3>
                        <p class="secure-label"><i class="fa-solid fa-circle-check"></i> 100% Secure Transaction</p>
                    </div>
                </div>
                <button type="button" class="portal-close" id="closePortalBtn">&times;</button>
            </div>

            <div class="portal-amount-row">
                <span>Amount to Pay</span>
                <span class="portal-amount" id="portalAmountText">₹0/-</span>
            </div>

            <div class="portal-tabs">
                <button type="button" class="portal-tab active" data-tab="card">
                    <i class="fa-regular fa-credit-card"></i> Card
                </button>
                <button type="button" class="portal-tab" data-tab="upi">
                    <i class="fa-solid fa-qrcode"></i> UPI / QR
                </button>
            </div>

            <!-- Card Tab View -->
            <div class="portal-tab-content active" id="tab-content-card">
                <div class="portal-input-group">
                    <label>Card Number</label>
                    <div style="position: relative;">
                        <input type="text" id="portalCardNum" placeholder="4111 2222 3333 4444" maxlength="19">
                        <span class="card-brand-icon" id="cardBrandIcon"><i class="fa-regular fa-credit-card"></i></span>
                    </div>
                </div>
                <div class="portal-row">
                    <div class="portal-input-group" style="flex:1;">
                        <label>Expiry Date</label>
                        <input type="text" id="portalCardExpiry" placeholder="MM/YY" maxlength="5">
                    </div>
                    <div class="portal-input-group" style="flex:1;">
                        <label>CVV</label>
                        <input type="password" id="portalCardCvv" placeholder="•••" maxlength="3">
                    </div>
                </div>
                <div class="portal-input-group">
                    <label>Name on Card</label>
                    <input type="text" id="portalCardName" placeholder="Enter cardholder's name">
                </div>
            </div>

            <!-- UPI Tab View -->
            <div class="portal-tab-content" id="tab-content-upi">
                <div class="portal-input-group">
                    <label>UPI ID (VPA)</label>
                    <input type="text" id="portalUpiId" placeholder="e.g. mobile@upi">
                </div>
                <div class="upi-qr-section">
                    <div class="upi-qr-box">
                        <!-- Simulated QR Code SVG -->
                        <svg width="120" height="120" viewBox="0 0 100 100">
                            <rect width="100" height="100" fill="#f8fafc"/>
                            <!-- QR Corners -->
                            <rect x="5" y="5" width="25" height="25" fill="#1e293b" rx="2"/>
                            <rect x="9" y="9" width="17" height="17" fill="#fff" rx="1"/>
                            <rect x="13" y="13" width="9" height="9" fill="#1e293b" rx="0.5"/>
                            
                            <rect x="70" y="5" width="25" height="25" fill="#1e293b" rx="2"/>
                            <rect x="74" y="9" width="17" height="17" fill="#fff" rx="1"/>
                            <rect x="78" y="13" width="9" height="9" rx="0.5" fill="#1e293b" />
                            
                            <rect x="5" y="70" width="25" height="25" fill="#1e293b" rx="2"/>
                            <rect x="9" y="74" width="17" height="17" fill="#fff" rx="1"/>
                            <rect x="13" y="78" width="9" height="9" fill="#1e293b" rx="0.5"/>
                            
                            <!-- Random QR dots -->
                            <rect x="40" y="10" width="8" height="8" fill="#1e293b" />
                            <rect x="50" y="20" width="8" height="8" fill="#1e293b" />
                            <rect x="45" y="35" width="15" height="5" fill="#1e293b" />
                            <rect x="35" y="55" width="10" height="10" fill="#1e293b" />
                            <rect x="55" y="60" width="8" height="15" fill="#1e293b" />
                            <rect x="75" y="45" width="15" height="8" fill="#1e293b" />
                            <rect x="80" y="60" width="12" height="12" fill="#1e293b" rx="1"/>
                            <rect x="84" y="64" width="4" height="4" fill="#fff" />
                        </svg>
                        <p class="qr-label">Scan QR to pay using any UPI app</p>
                    </div>
                </div>
            </div>

            <button type="button" class="portal-pay-btn" id="portalPayBtn">Pay Securely</button>
            
            <div class="portal-footer">
                <i class="fa-solid fa-lock"></i> Secured by Mock Gateway Payments
            </div>

            <!-- Loader Screen (Processing Overlay) -->
            <div class="portal-processing-overlay" id="portalProcessingOverlay">
                <div class="processing-spinner" id="processingSpinner"></div>
                <div class="success-checkmark" id="successCheckmark">
                    <div class="check-icon">
                        <span class="icon-line line-tip"></span>
                        <span class="icon-line line-long"></span>
                        <div class="icon-circle"></div>
                        <div class="icon-fix"></div>
                    </div>
                </div>
                <h4 id="processingTitle">Processing Payment...</h4>
                <p id="processingSubtitle">Please do not refresh or click back</p>
            </div>
        </div>
    </div>

</body>

</html>
