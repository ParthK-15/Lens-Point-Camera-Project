<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout & Payment — Sumati Color Lab</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/user-nav.css">
    <link rel="stylesheet" href="/css/search-autocomplete.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Playfair+Display:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Load Razorpay Checkout SDK -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        html, body, header, nav, .navigation, .navigation a, input, button, textarea, select, label, h1, h2, h3, h4, p, span, div, a {
            font-family: 'Times New Roman', Times, Georgia, serif !important;
            color: #111;
        }
        .navigation a {
            color: rgba(255, 255, 255, 0.8) !important;
        }
        .navigation a.active, .navigation a:hover {
            color: #ffffff !important;
        }
        body {
            background-color: #f8f9fa;
        }
        .checkout-layout {
            max-width: 1000px;
            margin: 2.5rem auto;
            padding: 0 1rem;
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 2rem;
        }
        @media (max-width: 768px) {
            .checkout-layout {
                grid-template-columns: 1fr;
            }
        }
        .checkout-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            border: 1px solid #eaeaea;
        }
        .checkout-card h2 {
            font-family: inherit;
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            padding-bottom: 0.8rem;
            border-bottom: 2px solid #f0f0f0;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #111;
            letter-spacing: -0.01em;
        }
        .form-group {
            margin-bottom: 1.2rem;
        }
        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            font-size: 0.9rem;
            color: #444;
        }
        .form-group input, .form-group textarea {
            width: 100%;
            padding: 0.85rem 1rem;
            border: 1.5px solid #e0e0e0;
            border-radius: 8px;
            font-size: 0.95rem;
            font-family: inherit;
            transition: border-color 0.2s ease;
            box-sizing: border-box;
        }
        .form-group input:focus, .form-group textarea:focus {
            border-color: #ff6600;
            outline: none;
        }
        .order-summary-items {
            max-height: 320px;
            overflow-y: auto;
            margin-bottom: 1.5rem;
            padding-right: 5px;
        }
        .summary-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px dashed #eee;
        }
        .summary-item:last-child {
            border-bottom: none;
        }
        .summary-item img {
            width: 55px;
            height: 55px;
            object-fit: cover;
            border-radius: 8px;
            background: #f4f4f4;
            border: 1px solid #eee;
        }
        .summary-item-details {
            flex: 1;
        }
        .summary-item-title {
            font-weight: 600;
            font-size: 0.92rem;
            color: #222;
        }
        .summary-item-qty {
            font-size: 0.8rem;
            color: #666;
            margin-top: 3px;
        }
        .summary-item-price {
            font-weight: 700;
            font-size: 0.95rem;
            color: #111;
        }
        .price-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.95rem;
            margin-bottom: 0.8rem;
            color: #555;
        }
        .price-row.total {
            font-size: 1.25rem;
            font-weight: 800;
            color: #111;
            padding-top: 1rem;
            border-top: 2px solid #111;
            margin-top: 1rem;
        }
        .pay-razorpay-btn {
            background: linear-gradient(135deg, #ff6600 0%, #e65c00 100%);
            color: #ffffff;
            width: 100%;
            padding: 1.1rem;
            border: none;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 6px 20px rgba(255, 102, 0, 0.3);
            transition: all 0.25s ease;
            margin-top: 1.5rem;
        }
        .pay-razorpay-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 102, 0, 0.4);
            background: linear-gradient(135deg, #e65c00 0%, #cc5200 100%);
        }
        .pay-razorpay-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
        .razorpay-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-top: 1rem;
            font-size: 0.8rem;
            color: #777;
        }
        .razorpay-badge i {
            color: #072654;
        }
    </style>
</head>

<body>
    <header>
        <nav>
            <div class="navigation">
                <a href="/" class="nav-logo-link" title="Home"><img src="/assets/images/logo.jpeg" alt="Sumati Colour Lab Logo" class="nav-logo-img"></a>
                <a href="/products">Camera</a>
                <a href="/lenses">Lens</a>
                <a href="/accessories">Accessories</a>
                <a href="#" class="cart-anchor" title="Cart">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="cart-count">0</span>
                </a>
                <div class="options">
                    <input type="text" placeholder="Search">
                    <label><i class="fa-solid fa-magnifying-glass"></i></label>
                    <% if (user) { %>
                        <% 
                            let initials = '?';
                            if (user.name) {
                                const parts = user.name.trim().split(/\s+/);
                                if (parts.length >= 2) { initials = (parts[0][0] + parts[1][0]).toUpperCase(); }
                                else { initials = parts[0].substring(0, 2).toUpperCase(); }
                            }
                        %>
                        <button type="button" class="user-avatar-btn" title="Signed in as <%= user.name %>" aria-label="Open profile menu"><%= initials %></button>
                    <% } else { %>
                        <button type="button" class="login" onclick="window.location='/auth/login'">Log In</button>
                    <% } %>
                </div>
            </div>
        </nav>
    </header>

    <div class="checkout-layout">
        <!-- Left: Customer Shipping Details -->
        <div class="checkout-card">
            <h2><i class="fa-solid fa-truck-ramp-box" style="color: #ff6600;"></i> Shipping Information</h2>
            <form id="paymentForm">
                <div class="form-group">
                    <label for="customerName">Full Name</label>
                    <input type="text" id="customerName" name="customerName" value="<%= user ? user.name : '' %>" placeholder="Enter your full name" required>
                </div>
                <div class="form-group">
                    <label for="customerEmail">Email Address</label>
                    <input type="email" id="customerEmail" name="customerEmail" value="<%= user ? user.email : '' %>" placeholder="name@example.com" required>
                </div>
                <div class="form-group">
                    <label for="customerPhone">Phone Number (10 digits)</label>
                    <input type="tel" id="customerPhone" name="customerPhone" value="<%= user && user.phone ? user.phone : '' %>" placeholder="e.g. 7038418286" required>
                </div>
                <div class="form-group">
                    <label for="shippingAddress">Delivery / Shipping Address</label>
                    <textarea id="shippingAddress" name="shippingAddress" rows="3" placeholder="House/Flat No., Building, Street, Area" required><%= user && (user.address || user.location) ? (user.address || user.location) : '' %></textarea>
                </div>
                <div class="form-group">
                    <label for="customerPincode">Area PIN Code (6 Digits)</label>
                    <input type="text" id="customerPincode" name="customerPincode" placeholder="e.g. 110001" maxlength="6" pattern="[0-9]{6}" required>
                </div>
                <button type="submit" id="paySubmitBtn" class="pay-razorpay-btn">
                    <i class="fa-solid fa-lock"></i> Pay Now via Razorpay
                </button>
                <div class="razorpay-badge">
                    <i class="fa-solid fa-shield-halved"></i> 256-Bit Encrypted & Secured by Razorpay
                </div>
            </form>
        </div>

        <!-- Right: Order Items & Total Summary -->
        <div class="checkout-card">
            <h2><i class="fa-solid fa-bag-shopping" style="color: #ff6600;"></i> Order Summary</h2>
            <div id="orderItemsContainer" class="order-summary-items">
                <!-- Dynamically populated from JS -->
            </div>
            <div class="price-row">
                <span>Subtotal</span>
                <span id="subtotalDisplay">₹0</span>
            </div>
            <div class="price-row">
                <span>Shipping</span>
                <span style="color: #28a745; font-weight: 600;">FREE</span>
            </div>
            <div class="price-row total">
                <span>Total Amount</span>
                <span id="totalDisplay" style="color: #ff6600;">₹0</span>
            </div>
        </div>
    </div>

    <script src="/js/user-nav.js"></script>
    <script src="/js/search-autocomplete.js"></script>
    <script>
        let checkoutCart = [];
        let grandTotal = 0;

        function initCheckoutSummary() {
            // Check if user came from a direct "Buy Now" single product click
            const buyNowItem = sessionStorage.getItem("buyNowItem");
            if (buyNowItem) {
                try {
                    checkoutCart = [JSON.parse(buyNowItem)];
                } catch(e) {}
            }

            // Fallback to general cart if no buyNowItem
            if (!checkoutCart || checkoutCart.length === 0) {
                try {
                    checkoutCart = JSON.parse(localStorage.getItem("cart") || "[]");
                } catch(e) {
                    checkoutCart = [];
                }
            }

            const container = document.getElementById("orderItemsContainer");
            if (!checkoutCart || checkoutCart.length === 0) {
                container.innerHTML = `<p style="color:#777; text-align:center; padding:2rem 0;">Your cart is empty!</p>`;
                document.getElementById("paySubmitBtn").disabled = true;
                return;
            }

            let itemsHTML = "";
            grandTotal = 0;

            checkoutCart.forEach(item => {
                const rawPrice = item.price;
                const priceNum = typeof rawPrice === "number"
                    ? rawPrice
                    : (parseInt(String(rawPrice).replace(/[^\d]/g, "")) || 0);
                const qty = parseInt(item.quantity) || 1;
                const itemTotal = priceNum * qty;
                grandTotal += itemTotal;

                const imageSrc = item.image || item.imageUrl || "/assets/images/photo.jpg";

                itemsHTML += `
                    <div class="summary-item">
                        <img src="${imageSrc}" alt="${item.title}" onerror="this.src='/assets/images/photo.jpg'">
                        <div class="summary-item-details">
                            <div class="summary-item-title">${item.title}</div>
                            <div class="summary-item-qty">Qty: ${qty} × ₹${priceNum.toLocaleString("en-IN")}</div>
                        </div>
                        <div class="summary-item-price">₹${itemTotal.toLocaleString("en-IN")}</div>
                    </div>
                `;
            });

            container.innerHTML = itemsHTML;
            document.getElementById("subtotalDisplay").innerText = "₹" + grandTotal.toLocaleString("en-IN");
            document.getElementById("totalDisplay").innerText = "₹" + grandTotal.toLocaleString("en-IN");
        }

        document.getElementById("paymentForm").addEventListener("submit", async function (e) {
            e.preventDefault();
            const payBtn = document.getElementById("paySubmitBtn");
            payBtn.disabled = true;
            payBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Preparing Payment...`;

            if (grandTotal <= 0 || !checkoutCart || checkoutCart.length === 0) {
                alert("Your cart is empty or amount is invalid!");
                payBtn.disabled = false;
                payBtn.innerHTML = `<i class="fa-solid fa-lock"></i> Pay Now via Razorpay`;
                return;
            }

            const customerName = document.getElementById("customerName").value.trim();
            const customerEmail = document.getElementById("customerEmail").value.trim();
            const customerPhone = document.getElementById("customerPhone").value.trim();
            const rawAddress = document.getElementById("shippingAddress").value.trim();
            const customerPincode = document.getElementById("customerPincode").value.trim();
            const shippingAddress = customerPincode ? `${rawAddress} - PIN: ${customerPincode}` : rawAddress;

            try {
                // 1. Create Razorpay Order on Backend
                const response = await fetch("/api/payment/create-order", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ amount: grandTotal }),
                });

                const data = await response.json();
                if (!data.success) {
                    alert("Error initiating Razorpay payment: " + (data.message || "Failed"));
                    payBtn.disabled = false;
                    payBtn.innerHTML = `<i class="fa-solid fa-lock"></i> Pay Now via Razorpay`;
                    return;
                }

                // 2. Open Razorpay Checkout Modal
                const options = {
                    key: data.keyId,
                    amount: data.amount,
                    currency: data.currency || "INR",
                    name: "Sumati Color Lab",
                    description: "Payment for " + (checkoutCart.length === 1 ? checkoutCart[0].title : checkoutCart.length + " Items"),
                    image: "/assets/images/logo.jpeg",
                    order_id: data.orderId,
                    handler: async function (razorpayRes) {
                        payBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Verifying Payment...`;

                        // 3. Verify Payment Signature on Server
                        try {
                            const verifyRes = await fetch("/api/payment/verify", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({
                                    razorpay_order_id: razorpayRes.razorpay_order_id,
                                    razorpay_payment_id: razorpayRes.razorpay_payment_id,
                                    razorpay_signature: razorpayRes.razorpay_signature,
                                    customerName,
                                    customerEmail,
                                    customerPhone,
                                    shippingAddress,
                                    cartData: checkoutCart,
                                    totalAmount: grandTotal,
                                }),
                            });

                            const verifyData = await verifyRes.json();
                            if (verifyData.success) {
                                // Clear Cart Storage
                                localStorage.removeItem("cart");
                                sessionStorage.removeItem("buyNowItem");

                                // Redirect to Order Confirmation Success Page
                                window.location.href = "/checkout-success?orderId=" + verifyData.orderId;
                            } else {
                                alert("Payment verification failed: " + (verifyData.message || "Invalid signature"));
                                payBtn.disabled = false;
                                payBtn.innerHTML = `<i class="fa-solid fa-lock"></i> Pay Now via Razorpay`;
                            }
                        } catch (err) {
                            console.error("Verification network error:", err);
                            alert("Payment verification network error. Please contact support if debited.");
                            payBtn.disabled = false;
                            payBtn.innerHTML = `<i class="fa-solid fa-lock"></i> Pay Now via Razorpay`;
                        }
                    },
                    prefill: {
                        name: customerName,
                        email: customerEmail,
                        contact: customerPhone,
                    },
                    theme: {
                        color: "#ff6600",
                    },
                    modal: {
                        ondismiss: function () {
                            payBtn.disabled = false;
                            payBtn.innerHTML = `<i class="fa-solid fa-lock"></i> Pay Now via Razorpay`;
                        }
                    }
                };

                const rzp = new Razorpay(options);
                rzp.open();
            } catch (err) {
                console.error("Payment initiation error:", err);
                alert("Could not connect to payment gateway. Please try again.");
                payBtn.disabled = false;
                payBtn.innerHTML = `<i class="fa-solid fa-lock"></i> Pay Now via Razorpay`;
            }
        });

        document.addEventListener("DOMContentLoaded", initCheckoutSummary);
    </script>
</body>

</html>
