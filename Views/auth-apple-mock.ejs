<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in with Apple</title>
    <link href="https://fonts.googleapis.com/css2?family=SF+Pro+Display:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #000000;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        .apple-card {
            background: #1c1c1e;
            border-radius: 14px;
            width: 100%;
            max-width: 420px;
            padding: 3rem 2.5rem;
            box-sizing: border-box;
            text-align: center;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .apple-logo {
            font-size: 3rem;
            margin-bottom: 1.5rem;
            color: #ffffff;
        }
        h1 {
            font-size: 1.4rem;
            font-weight: 600;
            margin: 0 0 0.5rem;
            letter-spacing: -0.01em;
        }
        p.subtitle {
            font-size: 0.95rem;
            color: #aeaeae;
            margin: 0 0 2.5rem;
        }
        .accounts-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
            text-align: left;
        }
        .account-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem;
            border: 1px solid #3a3a3c;
            border-radius: 10px;
            cursor: pointer;
            transition: background-color 0.2s, border-color 0.2s;
            background: #2c2c2e;
            width: 100%;
            font-family: inherit;
            color: #ffffff;
        }
        .account-item:hover {
            background-color: #3a3a3c;
            border-color: #48484a;
        }
        .account-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: #e5e5ea;
            color: #1c1c1e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.95rem;
        }
        .account-info {
            flex-grow: 1;
        }
        .account-name {
            font-size: 0.9rem;
            font-weight: 500;
        }
        .account-email {
            font-size: 0.8rem;
            color: #aeaeae;
        }
        .account-arrow {
            color: #8e8e93;
            font-size: 0.85rem;
        }
        .use-another-btn {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem;
            border: 1px solid #3a3a3c;
            border-radius: 10px;
            cursor: pointer;
            transition: background-color 0.2s;
            background: none;
            width: 100%;
            font-family: inherit;
            color: #0a84ff;
            font-weight: 500;
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }
        .use-another-btn:hover {
            background-color: #2c2c2e;
        }
        .custom-form {
            display: none;
            flex-direction: column;
            gap: 1rem;
            border: 1px solid #3a3a3c;
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            text-align: left;
            background: #2c2c2e;
        }
        .custom-form.active {
            display: flex;
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }
        .form-group label {
            font-size: 0.8rem;
            font-weight: 500;
            color: #aeaeae;
        }
        .form-group input {
            padding: 0.7rem 0.9rem;
            border: 1px solid #3a3a3c;
            border-radius: 6px;
            font-size: 0.92rem;
            outline: none;
            background: #1c1c1e;
            color: #ffffff;
        }
        .form-group input:focus {
            border-color: #0a84ff;
        }
        .submit-btn {
            background-color: #0a84ff;
            color: #fff;
            border: none;
            padding: 0.8rem;
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.92rem;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        .submit-btn:hover {
            background-color: #0070e3;
        }
        
        /* Face ID Simulator styles */
        .faceid-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(28,28,30,0.95);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }
        .faceid-overlay.active {
            display: flex;
        }
        .faceid-scanner {
            position: relative;
            width: 100px;
            height: 100px;
            border: 3px solid #3a3a3c;
            border-radius: 24px;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .faceid-scanner::before {
            content: '';
            position: absolute;
            width: 80px;
            height: 80px;
            border: 3px solid #0a84ff;
            border-radius: 18px;
            animation: pulse 1.5s infinite ease-in-out;
        }
        .faceid-scanner i {
            font-size: 3rem;
            color: #0a84ff;
            animation: scaleFace 1.5s infinite ease-in-out;
        }
        .faceid-text {
            font-size: 1.1rem;
            font-weight: 500;
            color: #ffffff;
        }
        .faceid-subtext {
            font-size: 0.85rem;
            color: #aeaeae;
            margin-top: 0.5rem;
        }

        @keyframes pulse {
            0% { transform: scale(0.9); opacity: 0.3; }
            50% { transform: scale(1); opacity: 1; border-color: #30d158; }
            100% { transform: scale(0.9); opacity: 0.3; }
        }
        @keyframes scaleFace {
            0% { transform: scale(0.95); }
            50% { transform: scale(1.05); color: #30d158; }
            100% { transform: scale(0.95); }
        }

        .footer {
            font-size: 0.75rem;
            color: #8e8e93;
            margin-top: 2.5rem;
        }
        .footer a {
            color: #0a84ff;
            text-decoration: none;
        }
        .footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="apple-card">
        <i class="fa-brands fa-apple apple-logo"></i>

        <h1>Sign in with Apple ID</h1>
        <p class="subtitle">to continue to Sumati Colour Lab</p>

        <!-- Hidden forms to POST credentials -->
        <form id="appleForm" action="/auth/apple/callback" method="POST">
            <input type="hidden" name="email" id="formEmail">
            <input type="hidden" name="name" id="formName">
            <input type="hidden" name="appleId" id="formAppleId">
            <input type="hidden" name="returnTo" value="<%= returnTo %>">
        </form>

        <div class="accounts-list">
            <!-- Account 1 -->
            <button type="button" class="account-item" onclick="triggerFaceId('john.doe@icloud.com', 'John Doe', 'ap_123456')">
                <div class="account-avatar">JD</div>
                <div class="account-info">
                    <div class="account-name">John Doe</div>
                    <div class="account-email">john.doe@icloud.com</div>
                </div>
                <i class="fa-solid fa-angle-right account-arrow"></i>
            </button>

            <!-- Account 2 -->
            <button type="button" class="account-item" onclick="triggerFaceId('sarah.k@icloud.com', 'Sarah Kak', 'ap_789101')">
                <div class="account-avatar">SK</div>
                <div class="account-info">
                    <div class="account-name">Sarah Kak</div>
                    <div class="account-email">sarah.k@icloud.com</div>
                </div>
                <i class="fa-solid fa-angle-right account-arrow"></i>
            </button>
        </div>

        <button type="button" class="use-another-btn" id="useAnotherBtn" onclick="toggleCustomForm()">
            <i class="fa-solid fa-user-plus"></i> Use a different Apple ID
        </button>

        <form class="custom-form" id="customForm" onsubmit="submitCustom(event)">
            <div class="form-group">
                <label for="custom-name">Full Name</label>
                <input type="text" id="custom-name" placeholder="John Doe" required>
            </div>
            <div class="form-group">
                <label for="custom-email">Apple ID (Email)</label>
                <input type="email" id="custom-email" placeholder="name@icloud.com" required>
            </div>
            <button type="submit" class="submit-btn">Next</button>
        </form>

        <div class="footer">
            Your Apple ID information is secure. <a href="#">Learn more...</a>
        </div>

        <!-- Face ID Simulation Screen overlay -->
        <div class="faceid-overlay" id="faceIdOverlay">
            <div class="faceid-scanner">
                <i class="fa-solid fa-face-smile-beam"></i>
            </div>
            <div class="faceid-text">Face ID</div>
            <div class="faceid-subtext">Authenticating via Apple ID Secure Enclave...</div>
        </div>
    </div>

    <script>
        function selectAccount(email, name, appleId) {
            document.getElementById('formEmail').value = email;
            document.getElementById('formName').value = name;
            document.getElementById('formAppleId').value = appleId;
            document.getElementById('appleForm').submit();
        }

        function triggerFaceId(email, name, appleId) {
            const overlay = document.getElementById('faceIdOverlay');
            overlay.classList.add('active');
            
            setTimeout(() => {
                selectAccount(email, name, appleId);
            }, 1800);
        }

        function toggleCustomForm() {
            const form = document.getElementById('customForm');
            const btn = document.getElementById('useAnotherBtn');
            if (form.classList.contains('active')) {
                form.classList.remove('active');
                btn.style.display = 'flex';
            } else {
                form.classList.add('active');
                btn.style.display = 'none';
            }
        }

        function submitCustom(e) {
            e.preventDefault();
            const name = document.getElementById('custom-name').value.trim();
            const email = document.getElementById('custom-email').value.trim();
            const id = 'ap_' + Math.floor(Math.random() * 1000000);
            triggerFaceId(email, name, id);
        }
    </script>
</body>
</html>
