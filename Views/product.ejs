<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.title %> | Sumati Colour Lab
    </title>
    <% if (product.category==='lens' ) { %>
        <link rel="stylesheet" href="/Lens/lens-info.css">
        <% } else if (product.category==='tripod' ) { %>
            <link rel="stylesheet" href="/Tripod/tripod-info.css">
            <% } else { %>
                <link rel="stylesheet" href="/Camera/camera-info.css">
                <% } %>
                    <link rel="stylesheet"
                        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
                    <link rel="stylesheet" href="/user-nav.css">
                    <script src="/cart-sync-head.js"></script>
</head>

<body>
    <header>
        <div id="progress-bar"></div>
        <nav>
            <div class="navigation">
                <a href="/index.html" class="nav-logo-link" title="Home"><img src="/Assets/logo.jpeg" alt="Sumati Colour Lab Logo" class="nav-logo-img"></a>
                <a href="#camera">
                    <%= product.category==='lens' ? 'Lens' : (product.category==='tripod' ? 'Tripod' : 'Camera' ) %>
                </a>
                <a href="#features">Features</a>
                <a href="#specs">Specifications</a>
                <a href="#design">Design</a>
                <a href="#connectivity">
                    <%= product.category==='lens' ? 'Usage' : 'Connectivity' %>
                </a>
                <a href="#" class="cart-anchor" title="Cart">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="cart-count">0</span>
                </a>
                <button class="interested">Log In</button>
            </div>
        </nav>
    </header>

    <% let backUrl="/products" ; if (product.category==='lens' ) backUrl="/lenses" ; else if
        (product.category==='tripod' ) backUrl="/tripods" ; %>
        <a href="<%= backUrl %>" class="back-btn">&#8592;</a>

        <main>

            <!-- ── HERO / SLIDER ── -->
            <section class="product-section" id="camera">
                <div
                    class="<%= product.category === 'lens' ? 'lens-info' : (product.category === 'tripod' ? 'tripod-info' : 'camera-info') %>">
                    <div class="main-content">
                        <button class="prev">&#10094;</button>
                        <img src="<%= product.image %>" alt="<%= product.title %>" id="slider-img">
                        <button class="next">&#10095;</button>
                        <div class="dots-container">
                            <% const allImages=Array.from(new Set([product.image, ...(product.sliderImages || [])])); %>
                                <% allImages.forEach((_, i)=> { %>
                                    <span class="dot <%= i === 0 ? 'active' : '' %>"></span>
                                    <% }) %>
                        </div>
                    </div>
                    <div class="product-info">
                        <h1>
                            <%= product.title %>
                        </h1>
                        <p class="price">₹<%= product.price.toLocaleString('en-IN') %>/-</p>
                        <p class="desc">
                            <%= product.description %>
                        </p>
                        <button class="buy-btn">Buy Now</button>
                        <button class="cart-btn">Add to Cart</button>
                    </div>
                </div>
            </section>

            <!-- ── KEY FEATURES + YouTube ── -->
            <section class="features-section" id="features">
                <div class="features-container">
                    <div class="features-left">
                        <h2>Key Features</h2>
                        <ul>
                            <% product.features.forEach(function(f) { %>
                                <li>
                                    <%= f %>
                                </li>
                                <% }) %>
                        </ul>
                    </div>
                    <% if (product.youtubeVideo) { %>
                        <div class="features-right">
                            <iframe width="560" height="315" src="<%= product.youtubeVideo %>?si=xyz"
                                title="YouTube video player" frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                        </div>
                        <% } %>
                </div>
            </section>

            <!-- ── SPECS TABLE ── -->
            <section class="specs-section" id="specs">
                <h2>Specifications</h2>
                <div class="specs-table">
                    <% product.specifications.forEach(function(spec) { %>
                        <div class="spec-item fade-in">
                            <span>
                                <%= spec.key %>
                            </span>
                            <span>
                                <%= spec.value %>
                            </span>
                        </div>
                        <% }) %>
                </div>
            </section>

            <!-- ── SPEC DETAIL BLOCKS ── -->
            <% if (product.detailSections && product.detailSections.length) { %>
                <section class="spec-details" id="specs">
                    <% product.detailSections.forEach(function(section, i) { %>
                        <div class="spec-block <%= i % 2 !== 0 ? 'reverse' : '' %> fade-in">
                            <div class="spec-img">
                                <img src="<%= section.image %>" alt="<%= section.title %>">
                            </div>
                            <div class="spec-text">
                                <h2>
                                    <%= section.title %>
                                </h2>
                                <p>
                                    <%= section.description %>
                                </p>
                            </div>
                        </div>
                        <% }) %>
                </section>
                <% } %>

                    <!-- ── DESIGN ── -->
                    <% if (product.designSections && product.designSections.length) { %>
                        <section class="design-section" id="design">
                            <h2 class="section-title">Design</h2>
                            <% product.designSections.forEach(function(section, i) { %>
                                <div class="design-block <%= i % 2 !== 0 ? 'reverse' : '' %> fade-in">
                                    <div class="design-img">
                                        <img src="<%= section.image %>" alt="<%= section.title %>">
                                    </div>
                                    <div class="design-text">
                                        <h2>
                                            <%= section.title %>
                                        </h2>
                                        <p>
                                            <%= section.description %>
                                        </p>
                                    </div>
                                </div>
                                <% }) %>
                        </section>
                        <% } %>

                            <!-- ── CONNECTIVITY ── -->
                            <% if (product.connectivity && product.connectivity.length) { %>
                                <section class="connectivity-section" id="connectivity">
                                    <h2 class="section-title">
                                        <%= product.category==='lens' ? 'Best Usage' : 'Connectivity' %>
                                    </h2>
                                    <div class="connect-container">
                                        <% product.connectivity.forEach(function(conn) { %>
                                            <div class="connect-row fade-in">
                                                <span>
                                                    <%= conn.title %>
                                                </span>
                                                <p>
                                                    <%= conn.description %>
                                                </p>
                                            </div>
                                            <% }) %>
                                    </div>
                                </section>
                                <% } %>

        </main>

        <footer>
            <div class="footer-main">
                <div class="main-footer">
                    <div class="brands">
                        <h2>Brands</h2>
                        <input type="checkbox" class="footer-checkbox" id="brands-check">
                        <label for="brands-check">
                            <i class="fa-solid fa-angle-down"></i>
                        </label>
                        <ul>
                            <li>Sony</li>
                            <li>Canon</li>
                            <li>Nikon</li>
                            <li>Fujifilm</li>
                            <li>GoPro</li>
                        </ul>
                    </div>
                    <div class="categories">
                        <h2>Categories</h2>
                        <input type="checkbox" class="footer-checkbox" id="categories-check">
                        <label for="categories-check">
                            <i class="fa-solid fa-angle-down"></i>
                        </label>
                        <ul>
                            <li>DSLR Cameras</li>
                            <li>Mirrorless Cameras</li>
                            <li>Lenses</li>
                            <li>Tripods</li>
                            <li>Lighting Equipment</li>
                        </ul>
                    </div>
                    <div class="foot-contact">
                        <h2>Contact Us</h2>
                        <input type="checkbox" class="footer-checkbox" id="contact-check">
                        <label for="contact-check">
                            <i class="fa-solid fa-angle-down"></i>
                        </label>
                        <p><i class="fa-solid fa-phone"></i> +91 7038418286</p>
                        <a href="https://www.instagram.com/sumati.color.lab?igsh=ZHIzam5hc3N6bmdj"><i
                                class="fa-brands fa-instagram"></i> Instagram</a>
                        <a href="mailto:khushallll409@gmail.com"><i class="fa-regular fa-envelope"></i> Gmail</a>
                    </div>
                    <div class="foot-location">
                        <h2>Our Location</h2>
                        <input type="checkbox" class="footer-checkbox" id="location-check">
                        <label for="location-check">
                            <i class="fa-solid fa-angle-down"></i>
                        </label>
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3766.527047318591!2d76.77415409999999!3d19.259433299999994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bd019cc2af79f0d%3A0x4d9b3ade4eff331!2sSumati%20Colour%20Lab!5e0!3m2!1sen!2sin!4v1772262216473!5m2!1sen!2sin"
                            style="border:0;" allowfullscreen="" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
                <div class="footer-bottom">
                    <hr>
                    <p>Copyright &copy; 2026 Sumati Color Lab. All Rights Reserved.</p>
                </div>
            </div>
        </footer>

        <script>
            // ── Slider ──────────────────────────────────────────────
            const allImages = Array.from(new Set([
                "<%= product.image %>",
                ...JSON.parse('<%- JSON.stringify(product.sliderImages || []) %>')
            ]));

            let currentIndex = 0;
            const sliderImage = document.getElementById("slider-img");
            const nextBtn = document.querySelector(".next");
            const prevBtn = document.querySelector(".prev");
            const dots = document.querySelectorAll(".dot");

            nextBtn.addEventListener("click", function () {
                currentIndex = (currentIndex + 1) % allImages.length;
                updateImage();
            });

            prevBtn.addEventListener("click", function () {
                currentIndex = (currentIndex - 1 + allImages.length) % allImages.length;
                updateImage();
            });

            function updateImage() {
                sliderImage.style.opacity = 0;
                setTimeout(() => {
                    sliderImage.src = allImages[currentIndex];
                    sliderImage.style.opacity = 1;
                }, 100);
                dots.forEach(dot => dot.classList.remove("active"));
                if (dots[currentIndex]) dots[currentIndex].classList.add("active");
            }

            dots.forEach((dot, index) => {
                dot.addEventListener("click", function () {
                    currentIndex = index;
                    updateImage();
                });
            });

            // ── Fade-in on scroll ────────────────────────────────────
            const elements = document.querySelectorAll(".fade-in");

            function showOnScroll() {
                elements.forEach((el) => {
                    const rect = el.getBoundingClientRect();
                    if (rect.top < window.innerHeight - 100) {
                        el.classList.add("show");
                    }
                });
            }

            window.addEventListener("scroll", showOnScroll);
            showOnScroll();

            // ── Active nav link on scroll ────────────────────────────
            const sections = document.querySelectorAll("section");
            const navLinks = document.querySelectorAll("nav a");

            function setActiveLink() {
                let currentSection = "";
                sections.forEach((section) => {
                    const rect = section.getBoundingClientRect();
                    if (rect.top <= 120 && rect.bottom >= 120) {
                        currentSection = section.getAttribute("id");
                    }
                });
                navLinks.forEach((link) => {
                    link.classList.remove("active");
                    if (link.getAttribute("href") === "#" + currentSection) {
                        link.classList.add("active");
                    }
                });
            }

            window.addEventListener("scroll", setActiveLink);
            window.addEventListener("load", setActiveLink);

            // ── Reading progress bar ─────────────────────────────────
            window.addEventListener("scroll", () => {
                const scroll = window.scrollY;
                const height = document.body.scrollHeight - window.innerHeight;
                const progress = (scroll / height) * 100;
                document.getElementById("progress-bar").style.width = progress + "%";
            });
        </script>

        <script src="/popup.js"></script>
        <script src="/user-nav.js"></script>
        <script src="/cart.js" defer></script>
</body>

</html>