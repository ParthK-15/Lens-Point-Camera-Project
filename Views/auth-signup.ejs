<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account — Sumati Colour Lab</title>
    <meta name="description" content="Create your Sumati Colour Lab account to start shopping premium photography gear.">
    <link rel="stylesheet" href="/auth.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="auth-page">

    <div class="auth-container">

        <!-- ── Brand Panel (Left) ─────────────────────────── -->
        <div class="auth-brand-panel">
            <div class="auth-brand-content">
                <div class="auth-brand-icon">
                    <i class="fa-solid fa-camera"></i>
                </div>
                <h2 class="auth-brand-title">Sumati Colour Lab</h2>
                <p class="auth-brand-subtitle">
                    Join thousands of photographers who trust us for their gear needs.
                </p>
                <div class="auth-brand-features">
                    <div class="auth-brand-feature">
                        <i class="fa-solid fa-check"></i>
                        <span>Free account — no credit card required</span>
                    </div>
                    <div class="auth-brand-feature">
                        <i class="fa-solid fa-check"></i>
                        <span>Save your cart and shop across devices</span>
                    </div>
                    <div class="auth-brand-feature">
                        <i class="fa-solid fa-check"></i>
                        <span>Faster checkout with saved details</span>
                    </div>
                    <div class="auth-brand-feature">
                        <i class="fa-solid fa-check"></i>
                        <span>Order tracking and purchase history</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Form Panel (Right) ─────────────────────────── -->
        <div class="auth-form-panel">
            <a href="/" class="auth-back-link">
                <i class="fa-solid fa-arrow-left"></i> Back to store
            </a>

            <div class="auth-form-wrapper">
                <div class="auth-form-header">
                    <h1>Create your account</h1>
                    <p>Fill in the details below to get started</p>
                </div>

                <% if (error) { %>
                    <div class="auth-alert auth-alert-error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <%= error %>
                    </div>
                <% } %>

                <form class="auth-form" action="/auth/signup" method="POST">
                    <div class="auth-input-group">
                        <label for="signup-name">Full Name</label>
                        <div class="auth-input-wrap">
                            <i class="fa-solid fa-user input-icon"></i>
                            <input type="text" id="signup-name" name="name"
                                placeholder="John Doe" required autocomplete="name"
                                minlength="2">
                        </div>
                    </div>

                    <div class="auth-input-group">
                        <label for="signup-email">Email Address</label>
                        <div class="auth-input-wrap">
                            <i class="fa-solid fa-envelope input-icon"></i>
                            <input type="email" id="signup-email" name="email"
                                placeholder="you@example.com" required autocomplete="email">
                        </div>
                    </div>

                    <div class="auth-input-group">
                        <label for="signup-password">Password</label>
                        <div class="auth-input-wrap">
                            <i class="fa-solid fa-lock input-icon"></i>
                            <input type="password" id="signup-password" name="password"
                                placeholder="At least 6 characters" required autocomplete="new-password"
                                minlength="6">
                            <button type="button" class="password-toggle" onclick="togglePassword('signup-password', this)">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="auth-input-group">
                        <label for="signup-confirm">Confirm Password</label>
                        <div class="auth-input-wrap">
                            <i class="fa-solid fa-shield-halved input-icon"></i>
                            <input type="password" id="signup-confirm" name="confirmPassword"
                                placeholder="Re-enter your password" required autocomplete="new-password"
                                minlength="6">
                            <button type="button" class="password-toggle" onclick="togglePassword('signup-confirm', this)">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="auth-submit-btn">
                        Create Account
                    </button>
                </form>

                <div class="auth-divider">
                    <span>or continue with</span>
                </div>

                <div class="auth-social-buttons">
                    <button type="button" class="auth-social-btn google" onclick="handleSocialLogin('google')">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        Continue with Google
                    </button>
                </div>

                <div class="auth-footer">
                    Already have an account? <a href="/auth/login">Sign In</a>
                </div>
            </div>
        </div>

    </div>

    <!-- ── Toast ──────────────────────────────────────────── -->
    <div class="auth-toast" id="authToast">
        <i class="fa-solid fa-circle-info"></i>
        <span id="authToastText"></span>
    </div>

    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fa-solid fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fa-solid fa-eye';
            }
        }

        function handleSocialLogin(provider) {
            const params = new URLSearchParams(window.location.search);
            const returnTo = params.get('returnTo') || '';
            window.location.href = '/auth/' + provider.toLowerCase() + '?returnTo=' + encodeURIComponent(returnTo);
        }
    </script>

</body>

</html>
