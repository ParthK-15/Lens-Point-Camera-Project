<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders | Sumati Colour Lab</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/user-nav.css">
    <link rel="stylesheet" href="/orders.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>

    <header style="background-color: #000; height: 4rem; display: flex; align-items: center;">
        <nav style="width: 100%; max-width: 1000px; margin: 0 auto; padding: 0 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <a href="/index.html" style="color: #fff; text-decoration: none; font-weight: 700; font-size: 1.2rem;">Sumati Colour Lab</a>
            <a href="/index.html" style="color: rgba(255,255,255,0.7); text-decoration: none; font-size: 0.9rem;"><i class="fa-solid fa-house"></i> Back to Home</a>
        </nav>
    </header>

    <main class="orders-container">
        <div class="orders-title-row">
            <h1>My Orders</h1>
            <a href="/index.html" class="back-shop-btn">
                <i class="fa-solid fa-basket-shopping"></i> Continue Shopping
            </a>
        </div>

        <% if (orders && orders.length > 0) { %>
            <div class="order-list">
                <% orders.forEach(order => { %>
                    <div class="order-card">
                        <div class="order-card-header">
                            <div class="order-meta-group">
                                <div class="order-meta-item">
                                    <span class="order-meta-label">Order Placed</span>
                                    <span class="order-meta-value">
                                        <%= new Date(order.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                    </span>
                                </div>
                                <div class="order-meta-item">
                                    <span class="order-meta-label">Total Amount</span>
                                    <span class="order-meta-value" style="color: var(--order-accent);">
                                        ₹<%= order.totalAmount.toLocaleString('en-IN') %>/-
                                    </span>
                                </div>
                                <div class="order-meta-item">
                                    <span class="order-meta-label">Order ID</span>
                                    <span class="order-meta-value" style="font-family: monospace; color: var(--order-text-muted);">
                                        <%= order._id %>
                                    </span>
                                </div>
                            </div>
                            
                            <div class="order-status-badge <%= order.status %>">
                                <% if (order.status === 'pending') { %>
                                    <i class="fa-regular fa-clock"></i>
                                <% } else if (order.status === 'confirmed') { %>
                                    <i class="fa-solid fa-check"></i>
                                <% } else if (order.status === 'shipped') { %>
                                    <i class="fa-solid fa-truck"></i>
                                <% } else if (order.status === 'delivered') { %>
                                    <i class="fa-solid fa-circle-check"></i>
                                <% } else if (order.status === 'cancelled') { %>
                                    <i class="fa-solid fa-ban"></i>
                                <% } %>
                                <span><%= order.status %></span>
                            </div>
                        </div>

                        <div class="order-card-body">
                            <div class="order-items-section">
                                <% order.items.forEach(item => { %>
                                    <div class="order-item-row">
                                        <img src="<%= item.image %>" alt="<%= item.title %>">
                                        <div class="order-item-details">
                                            <a href="/product/<%= item.productId ? item.productId : '' %>" class="order-item-name">
                                                <%= item.title %>
                                            </a>
                                            <span class="order-item-qty">Quantity: <%= item.quantity %></span>
                                        </div>
                                        <div class="order-item-price">
                                            ₹<%= (item.price * item.quantity).toLocaleString('en-IN') %>/-
                                        </div>
                                    </div>
                                <% }) %>
                            </div>

                            <div class="order-card-footer-details">
                                <div class="shipping-info-box">
                                    <h3>Shipping Details</h3>
                                    <p><strong>Recipient:</strong> <%= order.customerName %></p>
                                    <p><strong>Phone:</strong> <%= order.customerPhone %></p>
                                    <p><strong>Address:</strong> <%= order.shippingAddress %></p>
                                    <% if (order.notes) { %>
                                        <div class="notes-highlight">
                                            <strong>Note:</strong> <%= order.notes %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="orders-empty-state">
                <i class="fa-solid fa-box-open orders-empty-icon"></i>
                <h2>No Orders Yet</h2>
                <p>Looks like you haven't placed any orders yet. Discover our premium collection of cameras and accessories!</p>
                <a href="/index.html" class="browse-btn">
                    <i class="fa-solid fa-magnifying-glass"></i> Browse Products
                </a>
            </div>
        <% } %>
    </main>

    <script src="/user-nav.js"></script>
</body>

</html>
