<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders — Sumati Color Lab</title>
    <link rel="stylesheet" href="/css/orders.css">
    <link rel="stylesheet" href="/css/user-nav.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>
    <header>
        <nav>
            <div class="navigation">
                <a href="/" class="nav-logo-link" title="Home"><img src="/assets/images/logo.jpeg" alt="Sumati Colour Lab Logo" class="nav-logo-img"></a>
                <a href="/products">Camera</a>
                <a href="/lenses">Lens</a>
                <a href="/accessories">Accessories</a>
            </div>
        </nav>
    </header>

    <div style="max-width: 900px; margin: 2rem auto; padding: 1rem;">
        <h2>Order History</h2>
        <% if (orders && orders.length > 0) { %>
            <% orders.forEach(o => { %>
                <div style="background: white; border-radius: 8px; padding: 1.5rem; margin-top: 1rem; border: 1px solid #eee;">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #eee; padding-bottom: 0.5rem; margin-bottom: 1rem;">
                        <span>Order #<%= o._id %></span>
                        <span>Status: <strong style="color: orange;"><%= o.status %></strong></span>
                    </div>
                    <div>
                        <% if (o.items && o.items.length > 0) { %>
                            <% o.items.forEach(i => { %>
                                <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem;">
                                    <img src="<%= i.image %>" alt="<%= i.title %>" style="width: 50px; height: 50px; object-fit: contain;">
                                    <div style="flex: 1;">
                                        <h4><%= i.title %></h4>
                                        <p>Qty: <%= i.quantity %> × ₹<%= i.price %></p>
                                    </div>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>
                    <div style="border-top: 1px solid #eee; pt: 0.5rem; margin-top: 0.5rem; text-align: right;">
                        <h3>Total: ₹<%= o.totalAmount ? o.totalAmount.toLocaleString('en-IN') : '0' %></h3>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div style="padding: 3rem; text-align: center;">
                <p>No orders found.</p>
            </div>
        <% } %>
    </div>

    <script src="/js/user-nav.js"></script>
</body>

</html>
