<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sumati Color Lab</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/user-nav.css">
    <link rel="stylesheet" href="/css/search-autocomplete.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=Playfair+Display:wght@600&display=swap"
        rel="stylesheet">
    <script src="/js/cart-sync-head.js"></script>
</head>

<body>
    <header>
        <nav>
            <div class="navigation">
                <a href="/" class="nav-logo-link" title="Home"><img src="/assets/images/logo.jpeg" alt="Sumati Colour Lab Logo" class="nav-logo-img"></a>
                <a href="/products">Camera</a>
                <a href="/lenses">Lens</a>
                <a href="/accessories">Accessories</a>
                <a href="#" class="cart-anchor" title="Cart">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="cart-count">0</span>
                </a>
                <div class="options">
                    <input type="text" placeholder="Search">
                    <label>
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </label>
                    <% if (user) { %>
                        <% 
                            let initials = '?';
                            if (user.name) {
                                const parts = user.name.trim().split(/\s+/);
                                if (parts.length >= 2) { initials = (parts[0][0] + parts[1][0]).toUpperCase(); }
                                else { initials = parts[0].substring(0, 2).toUpperCase(); }
                            }
                        %>
                        <button type="button" class="user-avatar-btn" title="Signed in as <%= user.name %>" aria-label="Open profile menu"><%= initials %></button>
                    <% } else { %>
                        <button class="login" onclick="window.location='/auth/login'">Log In</button>
                    <% } %>
                </div>
            </div>
        </nav>
    </header>
    <aside>
        <input type="checkbox" id="check">
        <div class="btn_one">
            <label for="check">
                <i class="fa-solid fa-bars"></i> </label>
        </div>
        <div class="mainbox">
            <div class="btn_two">
                <label for="check">
                    <i class="fa-solid fa-xmark"></i> </label>
            </div>
            <div class="sidebar">
                <div class="head">
                    <a href="/"><img src="/assets/images/logo.jpeg" alt="Sumati Colour Lab Logo" class="mobile-menu-logo"></a>
                </div>
                <hr>
                <div class="sidebar_menu">
                    <a href="/">Home</a>
                    <a href="/products">Camera</a>
                    <a href="/lenses">Lens</a>
                    <a href="/accessories">Accessories</a>
                    <a href="#" class="cart-anchor-mobile">
                        <i class="fa-solid fa-cart-shopping"></i> Cart
                        <span class="cart-count-mobile">0</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="searchIcon">
            <input type="text" placeholder="Search" class="inputMobile">
            <label for="input">
                <i class="fa-solid fa-magnifying-glass" id="searchButton"></i>
            </label>
            <% if (user) { %>
                <% 
                    let initials = '?';
                    if (user.name) {
                        const parts = user.name.trim().split(/\s+/);
                        if (parts.length >= 2) { initials = (parts[0][0] + parts[1][0]).toUpperCase(); }
                        else { initials = parts[0].substring(0, 2).toUpperCase(); }
                    }
                %>
                <button type="button" class="user-avatar-btn" title="Signed in as <%= user.name %>" aria-label="Open profile menu"><%= initials %></button>
            <% } else { %>
                <button class="login2" onclick="window.location='/auth/login'">Log In</button>
            <% } %>
        </div>
    </aside>

    <main>
        <div class="main">
            <div class="image">
                <div class="tag_line">
                    <h1 class="tag_line1">Focus.</h1>
                    <h1 class="tag_line2">
                        Cl<span class="i-highlight">i</span>ck.
                    </h1>
                    <h1 class="tag_line3">Create.</h1>
                </div>
                <img src="/assets/images/photo.jpg" alt="camera">
            </div>
        </div>
        <div class="main-content">
            <!-- Section 1: Main Categories -->
            <div class="category-section-header">
                <span class="section-badge">COLLECTION</span>
                <h2>Explore Camera Gear</h2>
            </div>
            <div class="row-one">
                <a href="/products" class="camera-card first-row-content">
                    <div class="card-img-wrap">
                        <img src="/assets/images/gen_camera.jpg" alt="camera">
                    </div>
                    <div class="card-overlay-badge">
                        <h2>Camera</h2>
                        <span class="explore-tag">Browse All <i class="fa-solid fa-arrow-right"></i></span>
                    </div>
                </a>
                <a href="/lenses" class="lens-card first-row-content">
                    <div class="card-img-wrap">
                        <img src="/assets/images/gen_lens.jpg" alt="lens">
                    </div>
                    <div class="card-overlay-badge">
                        <h2>Lens</h2>
                        <span class="explore-tag">Browse All <i class="fa-solid fa-arrow-right"></i></span>
                    </div>
                </a>
                <a href="/category/tripod" class="tripod-content first-row-content">
                    <div class="card-img-wrap">
                        <img src="/assets/images/gen_tripod.jpg" alt="tripod">
                    </div>
                    <div class="card-overlay-badge">
                        <h2>Tripods</h2>
                        <span class="explore-tag">Browse All <i class="fa-solid fa-arrow-right"></i></span>
                    </div>
                </a>
                <a href="/category/lighting" class="lights-content first-row-content">
                    <div class="card-img-wrap">
                        <img src="/assets/images/gen_lighting.jpg" alt="lights">
                    </div>
                    <div class="card-overlay-badge">
                        <h2>Lightings</h2>
                        <span class="explore-tag">Browse All <i class="fa-solid fa-arrow-right"></i></span>
                    </div>
                </a>
                <a href="/category/microphone" class="microphone-content first-row-content">
                    <div class="card-img-wrap">
                        <img src="/assets/images/gen_mic.jpg" alt="microphone">
                    </div>
                    <div class="card-overlay-badge">
                        <h2>Mics</h2>
                        <span class="explore-tag">Browse All <i class="fa-solid fa-arrow-right"></i></span>
                    </div>
                </a>
            </div>

            <!-- Section 2: Official Brands -->
            <div class="category-section-header">
                <span class="section-badge">BRANDS</span>
                <h2>Official Brand Stores</h2>
            </div>
            <div class="row-two">
                <a href="/products?brand=Sony" class="sony first-row-content brand-card">
                    <img src="/assets/images/Sony-logo copy.jpg" alt="sony">
                    <span class="brand-tag">Sony Gear <i class="fa-solid fa-chevron-right"></i></span>
                </a>
                <a href="/products?brand=Canon" class="canon first-row-content brand-card">
                    <img src="/assets/images/6613e68f1a19d0ab2c380077_Canon1-min.jpg" alt="canon">
                    <span class="brand-tag">Canon Gear <i class="fa-solid fa-chevron-right"></i></span>
                </a>
                <a href="/products?brand=Nikon" class="nikon first-row-content brand-card">
                    <img src="/assets/images/ba64c159f9ea8aebec751caf983114f7.jpg" alt="nikon">
                    <span class="brand-tag">Nikon Gear <i class="fa-solid fa-chevron-right"></i></span>
                </a>
                <a href="/products?brand=Fujifilm" class="fujifilm first-row-content brand-card">
                    <img src="/assets/images/fujifilm-logo.svg" alt="fujifilm">
                    <span class="brand-tag">Fujifilm Gear <i class="fa-solid fa-chevron-right"></i></span>
                </a>
            </div>

            <!-- Section 3: Essential Accessories -->
            <div class="category-section-header">
                <span class="section-badge">ESSENTIALS</span>
                <h2>Pro Accessories & Gear</h2>
            </div>
            <div class="row-three">
                <a href="/category/battery" class="batteries-content first-row-content">
                    <div class="card-img-wrap">
                        <img src="/assets/images/gen_battery.jpg" alt="batteries">
                    </div>
                    <div class="card-overlay-badge">
                        <h2>Batteries</h2>
                        <span class="explore-tag">Browse All <i class="fa-solid fa-arrow-right"></i></span>
                    </div>
                </a>
                <a href="/category/storage" class="storage first-row-content">
                    <div class="card-img-wrap">
                        <img src="/assets/images/gen_storage.jpg" alt="memory">
                    </div>
                    <div class="card-overlay-badge">
                        <h2>Storage</h2>
                        <span class="explore-tag">Browse All <i class="fa-solid fa-arrow-right"></i></span>
                    </div>
                </a>
                <a href="/category/gimbal" class="gimbal-content first-row-content">
                    <div class="card-img-wrap">
                        <img src="/assets/images/gen_gimbal.jpg" alt="gimbal">
                    </div>
                    <div class="card-overlay-badge">
                        <h2>Gimbals</h2>
                        <span class="explore-tag">Browse All <i class="fa-solid fa-arrow-right"></i></span>
                    </div>
                </a>
                <a href="/category/bag" class="bags-content first-row-content">
                    <div class="card-img-wrap">
                        <img src="/assets/images/41lo5GlrIDL._AC_SY1000__nobg.png" alt="bag">
                    </div>
                    <div class="card-overlay-badge">
                        <h2>Bags</h2>
                        <span class="explore-tag">Browse All <i class="fa-solid fa-arrow-right"></i></span>
                    </div>
                </a>
                <a href="/category/film" class="films-content first-row-content">
                    <div class="card-img-wrap">
                        <img src="/assets/images/0053767_fujifilm-instax-square-monochrome-instant-film-10-exposures_360_nobg.png" alt="Films & Albums">
                    </div>
                    <div class="card-overlay-badge">
                        <h2>Films & Albums</h2>
                        <span class="explore-tag">Browse All <i class="fa-solid fa-arrow-right"></i></span>
                    </div>
                </a>
            </div>
        </div>
    </main>

    <footer>
        <div class="footer-main">
            <div class="main-footer">
                <div class="brands">
                    <h2>Brands</h2>
                    <input type="checkbox" class="footer-checkbox" id="brands-check">
                    <label for="brands-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <ul>
                        <li>Sony</li>
                        <li>Canon</li>
                        <li>Nikon</li>
                        <li>Fujifilm</li>
                        <li>GoPro</li>
                    </ul>
                </div>
                <div class="categories">
                    <h2>Categories</h2>
                    <input type="checkbox" class="footer-checkbox" id="categories-check">
                    <label for="categories-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <ul>
                        <li>DSLR Cameras</li>
                        <li>Mirrorless Cameras</li>
                        <li>Lenses</li>
                        <li>Tripods</li>
                        <li>Lighting Equipment</li>
                    </ul>
                </div>
                <div class="foot-contact">
                    <h2>Contact Us</h2>
                    <input type="checkbox" class="footer-checkbox" id="contact-check">
                    <label for="contact-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <p><i class="fa-solid fa-phone"></i> +91 7038418286</p>
                    <a href="https://www.instagram.com/sumati.color.lab?igsh=ZHIzam5hc3N6bmdj"><i class="fa-brands fa-instagram"></i> Instagram</a>
                    <a href="mailto:khushallll409@gmail.com"><i class="fa-regular fa-envelope"></i> Gmail</a>
                </div>
                <div class="foot-location">
                    <h2>Our Location</h2>
                    <input type="checkbox" class="footer-checkbox" id="location-check">
                    <label for="location-check">
                        <i class="fa-solid fa-angle-down"></i>
                    </label>
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3766.527047318591!2d76.77415409999999!3d19.259433299999994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bd019cc2af79f0d%3A0x4d9b3ade4eff331!2sSumati%20Colour%20Lab!5e0!3m2!1sen!2sin!4v1772262216473!5m2!1sen!2sin"
                        style="border:0;" allowfullscreen="" loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
            <div class="footer-bottom">
                <hr>
                <p>Copyright © 2026 Sumati Color Lab. All Rights Reserved.</p>
            </div>
        </div>
    </footer>
    <script src="/js/app.js"></script>
    <script src="/js/popup.js"></script>
    <script src="/js/user-nav.js"></script>
    <script src="/js/search-autocomplete.js"></script>
    <script src="/js/cart.js" defer></script>
</body>

</html>
