<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Successful — Sumati Color Lab</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/user-nav.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Playfair+Display:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        html, body, header, nav, .navigation, input, button, textarea, select, label, h1, h2, h3, h4, p, span, div, a {
            font-family: 'Times New Roman', Times, Georgia, serif !important;
            color: #111;
        }
        .navigation a {
            color: rgba(255, 255, 255, 0.85) !important;
        }
        .navigation a:hover {
            color: #ffffff !important;
        }
        body {
            background-color: #f8f9fa;
        }
        h2 {
            font-family: inherit;
        }
        .success-box {
            max-width: 620px;
            margin: 4rem auto;
            text-align: center;
            padding: 2.5rem;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            border: 1px solid #eaeaea;
        }
        .success-icon {
            font-size: 4rem;
            color: #28a745;
            margin-bottom: 1rem;
        }
        .order-badge {
            display: inline-block;
            background: #e8f5e9;
            color: #2e7d32;
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-size: 0.88rem;
            font-weight: 600;
            margin: 0.8rem 0;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 0.6rem 0;
            border-bottom: 1px dashed #eee;
            font-size: 0.95rem;
            color: #444;
        }
        .action-btns {
            margin-top: 2rem;
            display: flex;
            justify-content: center;
            gap: 1rem;
        }
        .btn-primary {
            padding: 0.85rem 1.8rem;
            background: #ff6600;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: background 0.2s ease;
        }
        .btn-primary:hover { background: #e65c00; }
        .btn-secondary {
            padding: 0.85rem 1.8rem;
            background: #222;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: background 0.2s ease;
        }
        .btn-secondary:hover { background: #111; }
    </style>
</head>

<body>
    <header>
        <nav>
            <div class="navigation">
                <a href="/" class="nav-logo-link" title="Home"><img src="/assets/images/logo.jpeg" alt="Sumati Colour Lab Logo" class="nav-logo-img"></a>
                <a href="/products">Camera</a>
                <a href="/lenses">Lens</a>
                <a href="/accessories">Accessories</a>
            </div>
        </nav>
    </header>

    <div class="success-box">
        <i class="fa-solid fa-circle-check success-icon"></i>
        <h2>Payment & Order Confirmed!</h2>
        <div class="order-badge"><i class="fa-solid fa-shield-check"></i> Paid via Razorpay</div>
        
        <% if (order) { %>
            <div style="margin: 1.5rem 0; text-align: left; background: #fafafa; padding: 1.2rem; border-radius: 10px;">
                <div class="detail-row">
                    <span>Order ID:</span>
                    <strong>#<%= order._id %></strong>
                </div>
                <% if (order.razorpayPaymentId) { %>
                    <div class="detail-row">
                        <span>Payment ID:</span>
                        <strong style="color: #072654;"><%= order.razorpayPaymentId %></strong>
                    </div>
                <% } %>
                <div class="detail-row">
                    <span>Customer Name:</span>
                    <strong><%= order.customerName %></strong>
                </div>
                <div class="detail-row">
                    <span>Amount Paid:</span>
                    <strong style="color: #ff6600; font-size: 1.1rem;">₹<%= order.totalAmount ? order.totalAmount.toLocaleString('en-IN') : '0' %></strong>
                </div>
                <div class="detail-row" style="border-bottom: none;">
                    <span>Delivery Address:</span>
                    <strong style="text-align: right; max-width: 60%;"><%= order.shippingAddress %></strong>
                </div>
            </div>
        <% } else { %>
            <p style="color: #666; margin: 1rem 0;">Your payment was verified and your order has been placed successfully.</p>
        <% } %>

        <div class="action-btns">
            <a href="/orders" class="btn-primary"><i class="fa-solid fa-box"></i> View My Orders</a>
            <a href="/" class="btn-secondary"><i class="fa-solid fa-house"></i> Return to Home</a>
        </div>
    </div>

    <script src="/js/user-nav.js"></script>
</body>

</html>
