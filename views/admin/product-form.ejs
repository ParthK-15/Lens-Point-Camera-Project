<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isEdit ? 'Edit Product' : 'New Product' %> — Admin Portal</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body style="font-family: sans-serif; background: #f4f6f9; margin: 0; padding: 2rem;">
    <div style="max-width: 700px; margin: 0 auto; background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
        <h2><%= isEdit ? 'Edit Product' : 'Add New Product' %></h2>
        <% if (error) { %>
            <div style="background: #fee2e2; color: #dc2626; padding: 0.8rem; border-radius: 4px; margin-bottom: 1rem;"><%= error %></div>
        <% } %>
        <form action="<%= isEdit ? '/admin/products/' + product._id + '/edit' : '/admin/products' %>" method="POST" enctype="multipart/form-data">
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem;">Title</label>
                <input type="text" name="title" value="<%= product ? product.title : '' %>" required style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem;">Slug</label>
                <input type="text" name="slug" value="<%= product ? product.slug : '' %>" required style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem;">Category</label>
                <select name="category" required style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 4px;">
                    <option value="camera" <%= product && product.category === 'camera' ? 'selected' : '' %>>Camera</option>
                    <option value="lens" <%= product && product.category === 'lens' ? 'selected' : '' %>>Lens</option>
                    <option value="tripod" <%= product && product.category === 'tripod' ? 'selected' : '' %>>Tripod</option>
                    <option value="accessory" <%= product && product.category === 'accessory' ? 'selected' : '' %>>Accessory</option>
                </select>
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem;">Price (₹)</label>
                <input type="number" name="price" value="<%= product ? product.price : '' %>" required style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem;">Image File (or URL)</label>
                <input type="file" name="imageFile" style="margin-bottom: 0.5rem;">
                <input type="text" name="image" value="<%= product ? product.image : '' %>" placeholder="Or image path e.g. /assets/images/logo.jpeg" style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem;">Description</label>
                <textarea name="description" rows="4" style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 4px;"><%= product ? product.description : '' %></textarea>
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem;">Product Images (for carousel slider — enter one URL per line)</label>
                <textarea name="images" rows="4" placeholder="/assets/images/img1.png&#10;/assets/images/img2.png" style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 4px;"><%= product && product.images ? product.images.join('\n') : (product && product.sliderImages ? product.sliderImages.join('\n') : '') %></textarea>
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem;">Key Features / Highlights (one per line)</label>
                <textarea name="highlights" rows="4" placeholder="24.2 MP Full-Frame Exmor R CMOS Sensor&#10;693-point phase-detection autofocus" style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 4px;"><%= product && product.highlights ? product.highlights.join('\n') : (product && product.features ? product.features.join('\n') : '') %></textarea>
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem;">YouTube Video URL (embed format)</label>
                <input type="text" name="youtubeUrl" value="<%= product ? (product.youtubeUrl || product.youtubeVideo || '') : '' %>" placeholder="https://www.youtube.com/embed/VIDEO_ID" style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem;">Spec Detail Blocks (JSON format)</label>
                <textarea name="specDetails" rows="4" placeholder='[{"image":"/assets/images/img.png","heading":"Full-Frame Sensor","text":"Description..."}]' style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 4px;"><%= product && (product.specDetails || product.detailSections) ? JSON.stringify(product.specDetails || product.detailSections) : '' %></textarea>
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem;">Design Blocks (JSON format)</label>
                <textarea name="designBlocks" rows="4" placeholder='[{"image":"/assets/images/img.png","heading":"Engineered for Precision","text":"Description..."}]' style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 4px;"><%= product && (product.designBlocks || product.designSections) ? JSON.stringify(product.designBlocks || product.designSections) : '' %></textarea>
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem;">Connectivity Rows (JSON format)</label>
                <textarea name="connectivity" rows="3" placeholder='[{"name":"Wi-Fi","description":"Wireless transfer..."}]' style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 4px;"><%= product && product.connectivity ? JSON.stringify(product.connectivity) : '' %></textarea>
            </div>
            <button type="submit" style="background: #2563eb; color: white; padding: 0.8rem 1.5rem; border: none; border-radius: 4px; font-size: 1rem; cursor: pointer;">Save Product</button>
            <a href="/admin/products" style="margin-left: 1rem; color: #64748b; text-decoration: none;">Cancel</a>
        </form>
    </div>
</body>

</html>
